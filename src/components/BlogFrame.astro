---
import CtaButton from "./CtaButton.astro";
import { CONTACT_EMAIL, WHATSAPP_HREF } from "../config/site.js";
---

<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

<header class="site-header" aria-label="Navegação principal">
  <a class="brand" href="/" aria-label="ConverteUp início">
    <span class="brand-mark">C</span>
    <span>ConverteUp</span>
  </a>
  <nav>
    <a href="/seo/">SEO</a>
    <a href="/google-ads/">Google Ads</a>
    <a href="/criacao-de-sites/">Criação de Sites</a>
    <a href="/contato/">Contato</a>
  </nav>
  <CtaButton href={WHATSAPP_HREF} label="Solicitar diagnóstico" variant="secondary" />
</header>

<main id="conteudo">
  <slot />
</main>

<footer class="site-footer">
  <a class="brand" href="/" aria-label="ConverteUp início">
    <span class="brand-mark">C</span>
    <span>ConverteUp</span>
  </a>
  <p>
    SEO, Google Ads, criação de sites e sistemas para empresas que precisam transformar procura,
    processos e dados em crescimento.
  </p>
  <a class="text-link" href="/blog/">Blog</a>
  <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
</footer>

<style is:global>
  :root {
    --ink: #183153;
    --ink-soft: rgba(31, 54, 92, 0.76);
    --ink-muted: rgba(31, 54, 92, 0.56);
    --paper: #eeebd3;
    --paper-strong: #faf8ea;
    --panel: rgba(255, 250, 240, 0.9);
    --olive: #679436;
    --moss: #5c946e;
    --blue: #87bfff;
    --line: rgba(31, 54, 92, 0.15);
    --shadow: 0 16px 42px rgba(31, 54, 92, 0.08);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
    line-height: 1.5;
    overflow-x: hidden;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(rgba(24, 49, 83, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 49, 83, 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    content: "";
    pointer-events: none;
  }

  h1,
  h2,
  h3 {
    color: var(--ink);
    font-family: "Manrope", "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .skip-link {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 20;
    transform: translateY(-160%);
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: var(--olive);
    color: #fff;
    padding: var(--space-3) var(--space-4);
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  main,
  .site-footer {
    width: min(100% - 32px, 1180px);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    font-family: "Manrope", "Segoe UI", sans-serif;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--olive);
    color: #fff;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-size: 0.92rem;
    font-weight: 700;
  }

  nav a,
  .text-link,
  .site-footer a:not(.brand) {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 180ms ease;
  }

  nav a:hover,
  .text-link:hover,
  .site-footer a:not(.brand):hover {
    color: var(--ink);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--olive);
    box-shadow: 6px 6px 0 var(--ink);
    color: #fff;
    padding: var(--space-3) var(--space-5);
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .cta-button:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .cta-button--secondary {
    background: var(--paper-strong);
    color: var(--ink);
  }

  .site-header .cta-button {
    white-space: nowrap;
  }

  .cta-button:focus-visible,
  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  .eyebrow {
    margin: 0;
    color: var(--moss);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid var(--line);
    margin-top: var(--space-9);
    padding-block: var(--space-7);
  }

  .site-footer p {
    max-width: 56ch;
    margin: 0;
    color: var(--ink-soft);
  }

  .site-footer > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .site-header,
    main,
    .site-footer {
      width: min(100% - 24px, 1180px);
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding-top: var(--space-5);
    }

    nav,
    .site-header .cta-button {
      display: none;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (min-width: 1100px) {
    .site-header,
    main,
    .site-footer {
      width: min(100% - 56px, 1180px);
    }
  }
</style>
