---
import { getCollection } from "astro:content";
import BlogCategoryNav from "../../../components/BlogCategoryNav.astro";
import BlogFrame from "../../../components/BlogFrame.astro";
import SeoHead from "../../../components/SeoHead.astro";
import { absoluteUrl, organizationSchema } from "../../../config/site.js";
import {
  BLOG_CATEGORIES,
  formatBlogDate,
  getBlogCategoryBySlug,
  getBlogCategoryPath,
  getBlogPostPath,
} from "../../../lib/blog";

export function getStaticPaths() {
  return BLOG_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getCollection("blog", ({ data }) => data.draft !== true && data.category === category.name)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const categoryFromSlug = getBlogCategoryBySlug(category.slug);
if (!categoryFromSlug) {
  return Astro.redirect("/blog/");
}

const pageTitle = `${category.name} | Blog ConverteUp`;
const pageDescription = `Artigos da ConverteUp sobre ${category.name}.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: absoluteUrl("/blog/"),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: category.name,
      item: absoluteUrl(getBlogCategoryPath(category.name)),
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead title={pageTitle} description={pageDescription} schema={[organizationSchema, breadcrumbSchema]} />
  </head>
  <body>
    <BlogFrame>
      <section class="category-hero" aria-labelledby="category-title">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{category.name}</span>
        </nav>
        <p class="eyebrow">Silo editorial</p>
        <h1 id="category-title">{category.name}</h1>
        <p>{pageDescription}</p>
      </section>

      <section class="blog-list-section" aria-labelledby="articles-title">
        <BlogCategoryNav activeSlug={category.slug} />
        <div class="blog-list-section__header">
          <h2 id="articles-title">Artigos de {category.name}</h2>
          <p>{posts.length} {posts.length === 1 ? "artigo" : "artigos"}</p>
        </div>

        {
          posts.length > 0 ? (
            <div class="blog-grid">
              {posts.map((post) => (
                <article class="blog-card">
                  {post.data.image && (
                    <a class="blog-card__image" href={getBlogPostPath(post)} aria-label={`Ler ${post.data.title}`}>
                      <img src={post.data.image} alt={post.data.imageAlt} loading="lazy" decoding="async" />
                    </a>
                  )}
                  <div class="blog-card__body">
                    <p class="blog-card__meta">
                      <span>{post.data.category}</span>
                      <time datetime={post.data.publishDate.toISOString()}>{formatBlogDate(post.data.publishDate)}</time>
                    </p>
                    <h3>
                      <a href={getBlogPostPath(post)}>{post.data.title}</a>
                    </h3>
                    <p>{post.data.description}</p>
                    <a class="text-link" href={getBlogPostPath(post)}>Ler artigo</a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">Nenhum artigo publicado nesta categoria ainda.</p>
          )
        }
      </section>
    </BlogFrame>
  </body>
</html>

<style>
  .category-hero {
    display: grid;
    gap: var(--space-4);
    max-width: 860px;
    padding-block: var(--space-6) var(--space-7);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--ink-muted);
    font-size: 0.9rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .breadcrumb a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .category-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 4.4rem);
    line-height: 0.98;
    overflow-wrap: anywhere;
  }

  .category-hero p:not(.eyebrow) {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    line-height: 1.7;
  }

  .blog-list-section {
    padding-block: var(--space-7);
  }

  .blog-list-section__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
  }

  .blog-list-section__header h2 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 3.1rem);
    line-height: 1;
  }

  .blog-list-section__header p {
    margin: 0;
    color: var(--ink-muted);
    font-weight: 800;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-5);
  }

  .blog-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--panel);
  }

  .blog-card__image {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-strong);
  }

  .blog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .blog-card__meta span {
    color: var(--moss);
  }

  .blog-card h3 {
    margin: 0;
    font-size: clamp(1.45rem, 4vw, 2rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .blog-card h3 a {
    text-decoration: none;
  }

  .blog-card p:not(.blog-card__meta) {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .empty-state {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    padding: var(--space-5);
    color: var(--ink-soft);
  }

  @media (max-width: 620px) {
    .category-hero {
      padding-block: var(--space-5) var(--space-6);
    }

    .category-hero h1 {
      max-width: 100%;
      font-size: clamp(1.95rem, 10vw, 3rem);
    }

    .blog-card h3 {
      font-size: clamp(1.35rem, 7vw, 1.8rem);
    }

    .blog-list-section__header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
