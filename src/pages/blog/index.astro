---
import { getCollection } from "astro:content";
import BlogCategoryNav from "../../components/BlogCategoryNav.astro";
import BlogFrame from "../../components/BlogFrame.astro";
import SeoHead from "../../components/SeoHead.astro";
import { absoluteUrl, organizationSchema } from "../../config/site.js";
import { BLOG_CATEGORIES, formatBlogDate, getBlogCategoryPath, getBlogPostPath } from "../../lib/blog";

const posts = (await getCollection("blog", ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const pageTitle = "Blog | ConverteUp";
const pageDescription =
  "Conteúdos da ConverteUp sobre SEO, criação de sites, Google Ads e aquisição digital para empresas.";

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog | ConverteUp",
  url: absoluteUrl("/blog/"),
  description: pageDescription,
  publisher: organizationSchema,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead title={pageTitle} description={pageDescription} schema={[organizationSchema, blogSchema]} />
  </head>
  <body>
    <BlogFrame>
      <section class="blog-hero" aria-labelledby="blog-title">
        <p class="eyebrow">Blog</p>
        <h1 id="blog-title">Conteúdo para transformar procura em crescimento.</h1>
        <p>
          Leituras sobre SEO, criação de sites, Google Ads e aquisição digital, com foco em clareza,
          decisão comercial e próximos passos.
        </p>
      </section>

      <section class="category-section" aria-labelledby="categories-title">
        <div class="blog-list-section__header">
          <h2 id="categories-title">Categorias</h2>
          <p>{BLOG_CATEGORIES.length} silos</p>
        </div>
        <div class="category-grid">
          {
            BLOG_CATEGORIES.map((category) => {
              const total = posts.filter((post) => post.data.category === category.name).length;

              return (
                <a class="category-card" href={getBlogCategoryPath(category.name)}>
                  <span>{category.name}</span>
                  <small>{total} {total === 1 ? "artigo" : "artigos"}</small>
                </a>
              );
            })
          }
        </div>
      </section>

      <section class="blog-list-section" aria-labelledby="articles-title">
        <BlogCategoryNav />
        <div class="blog-list-section__header">
          <h2 id="articles-title">Artigos recentes</h2>
          <p>{posts.length} {posts.length === 1 ? "artigo" : "artigos"}</p>
        </div>

        {
          posts.length > 0 ? (
            <div class="blog-grid">
              {posts.map((post) => (
                <article class="blog-card">
                  {post.data.image && (
                    <a class="blog-card__image" href={getBlogPostPath(post)} aria-label={`Ler ${post.data.title}`}>
                      <img
                        src={post.data.image}
                        alt={post.data.imageAlt}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div class="blog-card__body">
                    <p class="blog-card__meta">
                      <a href={getBlogCategoryPath(post.data.category)}>{post.data.category}</a>
                      <time datetime={post.data.publishDate.toISOString()}>{formatBlogDate(post.data.publishDate)}</time>
                    </p>
                    <h3>
                      <a href={getBlogPostPath(post)}>{post.data.title}</a>
                    </h3>
                    <p>{post.data.description}</p>
                    <a class="text-link" href={getBlogPostPath(post)}>Ler artigo</a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">Nenhum artigo publicado ainda.</p>
          )
        }
      </section>
    </BlogFrame>
  </body>
</html>

<style>
  .blog-hero {
    display: grid;
    gap: var(--space-4);
    max-width: 860px;
    padding-block: var(--space-7) var(--space-8);
  }

  .blog-hero h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.7rem, 11vw, 6.2rem);
    line-height: 0.92;
    overflow-wrap: anywhere;
  }

  .blog-hero p:not(.eyebrow) {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    line-height: 1.7;
  }

  .blog-list-section {
    padding-block: var(--space-7);
  }

  .category-section {
    padding-block: var(--space-4) var(--space-7);
  }

  .blog-list-section__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
  }

  .blog-list-section__header h2 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 3.1rem);
    line-height: 1;
  }

  .blog-list-section__header p {
    margin: 0;
    color: var(--ink-muted);
    font-weight: 800;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-5);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-4);
  }

  .category-card {
    display: grid;
    gap: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    padding: var(--space-5);
    text-decoration: none;
  }

  .category-card span {
    color: var(--ink);
    font-family: "Manrope", "Segoe UI", sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .category-card small {
    color: var(--ink-muted);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .blog-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--panel);
  }

  .blog-card__image {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-strong);
  }

  .blog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .blog-card__meta a {
    color: var(--moss);
    text-decoration: none;
  }

  .blog-card h3 {
    margin: 0;
    font-size: clamp(1.45rem, 4vw, 2rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .blog-card h3 a {
    text-decoration: none;
  }

  .blog-card p:not(.blog-card__meta) {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .empty-state {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    padding: var(--space-5);
    color: var(--ink-soft);
  }

  @media (max-width: 620px) {
    .blog-hero {
      padding-block: var(--space-6) var(--space-7);
    }

    .blog-hero h1 {
      max-width: 100%;
      font-size: clamp(2.25rem, 13vw, 3.8rem);
    }

    .blog-card h3 {
      font-size: clamp(1.35rem, 7vw, 1.8rem);
    }

    .blog-list-section__header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
