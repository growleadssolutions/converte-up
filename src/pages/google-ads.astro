---
import SiteNavigation from "../components/SiteNavigation.astro";
import CtaButton from "../components/CtaButton.astro";
import SeoHead from "../components/SeoHead.astro";
import { CONTACT_EMAIL, WHATSAPP_HREF, absoluteUrl } from "../config/site.js";

const campaignSteps = [
  {
    title: "Pesquisa",
    text: "Entendemos o que o cliente procura quando está pronto para pedir orçamento, ligar ou visitar.",
  },
  {
    title: "Anúncio",
    text: "Criamos mensagens alinhadas à intenção da busca, sem prometer o que a empresa não entrega.",
  },
  {
    title: "Página",
    text: "Levamos o visitante para uma página específica, com oferta clara e caminho de contato visível.",
  },
  {
    title: "Contato",
    text: "Organizamos a rota para WhatsApp, ligação, formulário ou visita, reduzindo atrito no momento da decisão.",
  },
  {
    title: "Otimização",
    text: "Acompanhamos termos, cliques e conversões para ajustar investimento e melhorar a qualidade das oportunidades.",
  },
];

const executionJourney = [
  {
    step: "01",
    title: "Mapeamos a demanda",
    text: "Identificamos termos, cidades, intenção de compra e buscas que podem virar contato real.",
  },
  {
    step: "02",
    title: "Organizamos a campanha",
    text: "Separamos grupos, anúncios, extensões e segmentações para evitar tráfego genérico.",
  },
  {
    step: "03",
    title: "Conectamos com a página certa",
    text: "Direcionamos o visitante para uma página clara, rápida e preparada para gerar contato.",
  },
  {
    step: "04",
    title: "Ajustamos pelo resultado",
    text: "Acompanhamos termos, cliques e contatos para manter o que funciona e corrigir desperdícios.",
  },
];

const investmentFactors = [
  {
    label: "Cidade",
    position: "top",
  },
  {
    label: "Concorrência",
    position: "left",
  },
  {
    label: "Objetivo",
    position: "right",
  },
  {
    label: "Ticket Médio",
    position: "bottom",
  },
];

const notRecommended = [
  {
    alertTitle: "Produto sem procura",
    alertText:
      "Quando quase ninguém pesquisa pela oferta, a campanha pode gerar pouco volume ou atrair buscas sem relação com a compra.",
    nextTitle: "Validar a demanda",
    nextText:
      "Antes de anunciar, avaliamos se existe procura suficiente e quais termos realmente representam interesse comercial.",
  },
  {
    alertTitle: "Margem muito baixa",
    alertText:
      "Se cada venda deixa pouca margem, o custo de aquisição pode consumir boa parte do retorno.",
    nextTitle: "Rever oferta e posicionamento",
    nextText:
      "É melhor ajustar ticket, margem ou proposta de valor antes de aumentar o investimento em mídia.",
  },
  {
    alertTitle: "Atendimento limitado",
    alertText:
      "Quando a empresa não consegue responder rapidamente aos novos contatos, parte do investimento se perde.",
    nextTitle: "Organizar o processo comercial",
    nextText:
      "Definimos como os leads serão recebidos, acompanhados e convertidos antes de aumentar o volume.",
  },
  {
    alertTitle: "Site sem estrutura",
    alertText:
      "Se a página não explica a oferta, demora para carregar ou dificulta o contato, os cliques não viram oportunidades.",
    nextTitle: "Preparar uma página adequada",
    nextText:
      "Criamos ou ajustamos a landing page para explicar valor, transmitir confiança e facilitar o próximo passo.",
  },
];

const faqs = [
  {
    question: "Quanto preciso investir?",
    answer:
      "Depende da concorrência, região, ticket médio, volume de buscas e objetivo comercial. Antes de sugerir verba, avaliamos se existe demanda suficiente e qual rota faz sentido para o negócio.",
  },
  {
    question: "Quanto tempo demora para aparecer?",
    answer:
      "Campanhas de Google Ads podem começar a aparecer pouco depois da configuração e aprovação dos anúncios. Ainda assim, os primeiros dados servem para ajustar termos, páginas e qualidade dos contatos.",
  },
  {
    question: "Google Ads funciona para pequenas empresas?",
    answer:
      "Sim, principalmente quando há pessoas pesquisando por serviços locais com intenção de contratar. O ponto central é anunciar para buscas certas e levar o visitante para uma página adequada.",
  },
  {
    question: "Vale mais a pena SEO ou Google Ads?",
    answer:
      "Eles têm papéis diferentes. Google Ads gera visibilidade imediata enquanto houver investimento. SEO constrói presença progressiva. Em muitos casos, os dois canais funcionam melhor juntos.",
  },
  {
    question: "Posso anunciar apenas em Curitiba?",
    answer:
      "Sim. Campanhas podem ser segmentadas por cidade, região ou área atendida. A segmentação precisa considerar onde a empresa realmente consegue atender bem.",
  },
  {
    question: "Preciso de um site?",
    answer:
      "É altamente recomendado ter uma página clara, rápida e orientada a contato. Enviar tráfego pago para uma página confusa costuma desperdiçar verba.",
  },
  {
    question: "Como acompanho os resultados?",
    answer:
      "Acompanhamos dados como termos pesquisados, cliques, contatos, origem das oportunidades e comportamento na página. Isso ajuda a decidir onde manter, cortar ou melhorar.",
  },
  {
    question: "O investimento vai para a Google ou para a ConverteUp?",
    answer:
      "A verba de mídia é paga à Google. A ConverteUp cobra pelo trabalho estratégico e operacional de pesquisa, estruturação, acompanhamento e otimização das campanhas.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Google Ads para empresas",
  provider: {
    "@type": "Organization",
    name: "ConverteUp",
    url: absoluteUrl("/"),
  },
  areaServed: "BR",
  serviceType: "Gestão de campanhas de Google Ads e campanhas de pesquisa",
  description:
    "Campanhas de Google Ads focadas em atrair clientes com intenção de compra através da Pesquisa Google.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Google Ads",
      item: absoluteUrl("/google-ads"),
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const pageTitle = "Google Ads para empresas | Gestão de campanhas | ConverteUp";
const pageDescription =
  "Criamos campanhas de Google Ads focadas em atrair clientes com intenção de compra através da Pesquisa Google.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      ogDescription="Campanhas de Google Ads para aparecer diante de clientes que pesquisam pelo serviço hoje."
      schema={[serviceSchema, breadcrumbSchema, faqSchema]}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <SiteNavigation />
      <CtaButton href={WHATSAPP_HREF} label="Solicitar diagnóstico" variant="secondary" />
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">GOOGLE ADS</p>
          <h1 id="hero-title">Apareça hoje para quem já procura pelo que você vende.</h1>
          <p class="hero__lead">
            Enquanto o SEO constrói presença de longo prazo, o Google Ads coloca sua empresa diante
            de clientes com intenção imediata de compra.
          </p>
          <div class="hero__actions">
            <CtaButton href={WHATSAPP_HREF} label="Quero anunciar no Google" />
          </div>
          <ul class="hero__signals" aria-label="Resultados comerciais buscados">
            <li>Contatos</li>
            <li>Ligações</li>
            <li>Visitas</li>
            <li>Oportunidades</li>
          </ul>
        </div>

        <figure class="ads-hero-media" aria-label="Visual de campanhas de Google Ads">
          <img
            src="/Image/Hero/google-ads-hero-1600.webp"
            alt="Painel visual representando campanhas de Google Ads, cliques qualificados e geração de oportunidades"
            width="1600"
            height="976"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </section>

      <section class="section click-quality" aria-labelledby="click-title">
        <div class="section-header">
          <p class="eyebrow">QUALIDADE DA DEMANDA</p>
          <h2 id="click-title">Nem todo clique<br />gera resultado.</h2>
          <p>
            Uma campanha eficiente não é aquela que recebe mais visitantes. É aquela que atrai
            pessoas com intenção real de contratar.
          </p>
        </div>
        <div class="traffic-compare" aria-label="Comparação entre tráfego e oportunidades">
          <article>
            <span>Empresa A</span>
            <strong>1000 cliques</strong>
            <p><em class="contact-metric contact-metric--low">20 contatos</em></p>
          </article>
          <div class="traffic-compare__versus">VS</div>
          <article class="traffic-compare__winner">
            <span>Empresa B</span>
            <strong>350 cliques</strong>
            <p><em class="contact-metric contact-metric--high">40 contatos</em></p>
          </article>
        </div>
        <p class="section-closing">Mais tráfego nem sempre significa mais clientes.</p>
      </section>

      <section class="section campaign-section" id="como-funciona" aria-labelledby="campaign-title">
        <div class="section-header">
          <p class="eyebrow">CAMPANHA</p>
          <h2 id="campaign-title">Como funciona<br />uma campanha.</h2>
        </div>
        <ol class="campaign-timeline" aria-label="Etapas de uma campanha de Google Ads">
          {campaignSteps.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section pillars-section" aria-labelledby="pillars-title">
        <div class="section-header">
          <p class="eyebrow">EXECUÇÃO</p>
          <h2 id="pillars-title">A jornada do serviço.</h2>
        </div>
        <ol class="execution-journey" aria-label="Jornada de execução do serviço de Google Ads">
          {executionJourney.map((item) => (
            <li>
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section difference-section" id="diferenciais" aria-labelledby="difference-title">
        <div class="section-header">
          <p class="eyebrow">DIFERENCIAIS</p>
          <h2 id="difference-title">O que diferencia nossas campanhas.</h2>
        </div>
        <div class="premium-compare" aria-label="Comparação entre práticas evitadas e práticas aplicadas">
          <article class="premium-compare__side premium-compare__side--avoid">
            <h3>Não fazemos</h3>
            <ul>
              <li><span aria-hidden="true">x</span> anunciar qualquer palavra</li>
              <li><span aria-hidden="true">x</span> enviar para Home</li>
              <li><span aria-hidden="true">x</span> campanhas sem mensuração</li>
              <li><span aria-hidden="true">x</span> decisões por achismo</li>
            </ul>
          </article>
          <article class="premium-compare__side premium-compare__side--do">
            <h3>Fazemos</h3>
            <ul>
              <li><span aria-hidden="true">✓</span> intenção comercial</li>
              <li><span aria-hidden="true">✓</span> páginas específicas</li>
              <li><span aria-hidden="true">✓</span> acompanhamento constante</li>
              <li><span aria-hidden="true">✓</span> decisões baseadas em dados</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="section channel-section" aria-labelledby="channel-title">
        <div class="section-header">
          <p class="eyebrow">ADS + SEO</p>
          <h2 id="channel-title">Google Ads e SEO trabalham juntos.</h2>
          <p>
            Google Ads gera visibilidade imediata. SEO constrói crescimento consistente.
          </p>
        </div>
        <div class="dual-channel" aria-label="Relação entre Google Ads e SEO ao longo do tempo">
          <article>
            <span>Hoje</span>
            <strong>Google Ads</strong>
            <p>Coloca a empresa diante de quem está pesquisando agora.</p>
          </article>
          <article>
            <span>Enquanto isso</span>
            <strong>SEO cresce</strong>
            <p>Constrói presença orgânica para reduzir dependência de um único canal.</p>
          </article>
          <article class="dual-channel__result">
            <span>Resultado</span>
            <strong>Dois canais</strong>
            <p>A empresa passa a combinar demanda imediata com crescimento consistente.</p>
          </article>
        </div>
        <p class="internal-note">
          Veja também como trabalhamos <a href="/seo/">SEO</a> e <a href="/criacao-de-sites/">Criação de Sites</a>.
        </p>
      </section>

      <section class="section investment-section" aria-labelledby="investment-title">
        <div class="section-header">
          <p class="eyebrow">INVESTIMENTO</p>
          <h2 id="investment-title">Quanto investir?</h2>
          <p>
            A verba depende do mercado, da região e do objetivo. Não colocamos preços fixos nem
            prometemos resultado automático, porque campanhas precisam respeitar a realidade do
            negócio.
          </p>
        </div>
        <div class="investment-orbit" aria-label="Fatores que influenciam o investimento">
          <strong class="investment-orbit__center">Investimento</strong>
          {investmentFactors.map((item) => (
            <span class={`investment-orbit__factor investment-orbit__factor--${item.position}`}>
              {item.label}
            </span>
          ))}
        </div>
      </section>

      <section class="section trust-section" aria-labelledby="trust-title">
        <div class="section-header">
          <p class="eyebrow">CRITÉRIO</p>
          <h2 id="trust-title">Nem todo negócio precisa anunciar agora.</h2>
          <p>
            Em alguns casos, investir antes de estruturar a base só aumenta o desperdício. Por isso,
            preferimos mostrar o que precisa ser corrigido antes de recomendar uma campanha.
          </p>
        </div>
        <div class="trust-list">
          {notRecommended.map((item) => (
            <article class="trust-row">
              <div class="trust-row__side trust-row__side--alert">
                <h3>{item.alertTitle}</h3>
              </div>
              <div class="trust-row__side trust-row__side--next">
                <h3>{item.nextTitle}</h3>
              </div>
            </article>
          ))}
        </div>
        <p class="trust-section__closing">
          Às vezes, a melhor decisão não é anunciar agora. É corrigir a base para não desperdiçar o
          próximo investimento.
        </p>
      </section>

      <section class="section case-study" aria-labelledby="case-title">
        <div class="case-study__intro">
          <p class="eyebrow">CASE REECELL</p>
          <h2 id="case-title">Google Ads como parte de uma estratégia maior.</h2>
          <p>
            Na Reecell, os anúncios não foram tratados como uma peça isolada. Eles fizeram parte de
            uma estrutura maior com site, SEO local, páginas por serviço, Google Business e melhoria
            contínua.
          </p>
        </div>
        <div class="case-story">
          <article>
            <span>Contexto</span>
            <p>
              A empresa já tinha demanda local e clientes reais, mas precisava transformar presença
              digital em um canal mais previsível de oportunidades.
            </p>
          </article>
          <article>
            <span>Estratégia</span>
            <p>
              O Google Ads ajudou a capturar buscas com intenção imediata enquanto o SEO e a estrutura
              do site fortaleciam o crescimento progressivo.
            </p>
          </article>
          <article>
            <span>Cuidado</span>
            <p>
              Os resultados do projeto não devem ser atribuídos apenas aos anúncios. O impacto veio
              do conjunto de ações e também de fatores externos do negócio.
            </p>
          </article>
        </div>
      </section>

      <section class="section faq" id="faq" aria-labelledby="faq-title">
        <div class="section-header">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Perguntas antes de investir em Google Ads.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta" id="diagnostico" aria-labelledby="diagnostic-title">
        <div class="final-cta__copy">
          <p class="eyebrow">DIAGNÓSTICO</p>
          <h2 id="diagnostic-title">Vamos descobrir se Google Ads faz sentido para sua empresa?</h2>
          <p>
            Antes de investir em anúncios, analisamos seu mercado, concorrência e potencial de retorno
            para construir campanhas alinhadas ao seu objetivo.
          </p>
        </div>
        <form
          class="diagnostic-form"
          action={`mailto:${CONTACT_EMAIL}`}
          method="post"
          enctype="text/plain"
          data-conversion="contact-form"
        >
          <label>
            <span>Nome</span>
            <input name="nome" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Telefone</span>
            <input name="telefone" type="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>Mensagem <small>(opcional)</small></span>
            <textarea name="mensagem" rows="4"></textarea>
          </label>
          <button class="cta-button" type="submit" data-cta="form-submit" data-conversion="contact-form">Solicitar diagnóstico</button>
          <p>Sem compromisso • resposta pelo WhatsApp</p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <p>
        Google Ads, <a href="/seo/">SEO</a>, <a href="/criacao-de-sites/">criação de sites</a> e
        sistemas para empresas locais que precisam transformar busca em oportunidade comercial.
      </p>
      <a class="text-link" href={WHATSAPP_HREF}>Contato</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #183153;
    --ink-soft: rgba(31, 54, 92, 0.76);
    --ink-muted: rgba(31, 54, 92, 0.56);
    --paper: #eeebd3;
    --paper-strong: #faf8ea;
    --panel: rgba(255, 250, 240, 0.9);
    --olive: #679436;
    --moss: #5c946e;
    --line: rgba(31, 54, 92, 0.15);
    --shadow: 0 16px 42px rgba(31, 54, 92, 0.08);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    color: var(--ink);
    background: var(--paper);
    font-size: 1rem;
    line-height: 1.62;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3,
  strong {
    font-family: "Manrope", "Segoe UI", sans-serif;
  }

  h1 {
    max-width: 12ch;
    color: var(--ink);
    font-size: clamp(2.5rem, 9vw, 5.6rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.08;
  }

  h2 {
    max-width: 16ch;
    color: var(--ink);
    font-size: clamp(2rem, 6vw, 3.8rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.02;
  }

  #click-title,
  #campaign-title {
    line-height: 1.14;
  }

  h3 {
    color: var(--ink);
    font-size: 1.28rem;
    font-weight: 800;
    line-height: 1.12;
  }

  a {
    color: inherit;
  }

  main,
  .site-header,
  .site-footer {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: 16px;
    z-index: 20;
    transform: translateY(-140%);
    background: var(--ink);
    color: #ffffff;
    padding: var(--space-3) var(--space-4);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--olive);
    color: #ffffff;
    font-size: 0.95rem;
  }

  nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  nav a,
  .text-link,
  .site-footer a:not(.brand) {
    color: var(--ink-soft);
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  .text-link:hover,
  .site-footer a:not(.brand):hover {
    color: var(--ink);
  }

  .cta-button,
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--olive);
    box-shadow: 6px 6px 0 var(--ink);
    color: #ffffff;
    cursor: pointer;
    font-weight: 800;
    line-height: 1.15;
    padding: var(--space-3) var(--space-5);
    text-align: center;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .cta-button:hover,
  button:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .cta-button--secondary {
    background: var(--paper-strong);
    box-shadow: none;
    color: var(--ink);
  }

  .site-header .cta-button {
    display: none;
  }

  .cta-button:focus-visible,
  a:focus-visible,
  summary:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid rgba(111, 153, 52, 0.42);
    outline-offset: 4px;
  }

  .eyebrow {
    color: var(--moss);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-7) var(--space-9);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__lead {
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.58;
  }

  .hero__lead + .hero__lead {
    margin-top: calc(var(--space-3) * -1);
  }

  .hero__actions {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    align-items: center;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__signals li {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__signals li + li::before {
    content: "/";
    margin-inline: var(--space-3);
    color: var(--olive);
  }

  .ads-hero-media {
    display: grid;
    min-width: 0;
    margin: 0;
  }

  .ads-hero-media img {
    display: block;
    width: 100%;
    max-width: 1066px;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    object-fit: contain;
  }

  .section {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .section-header,
  .case-study__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 820px;
  }

  .section-header p:not(.eyebrow),
  .case-study__intro p:not(.eyebrow) {
    max-width: 690px;
    color: var(--ink-soft);
    font-size: 1.06rem;
    line-height: 1.68;
  }

  .traffic-compare {
    display: grid;
    gap: var(--space-4);
    align-items: stretch;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-5);
  }

  .traffic-compare article {
    display: grid;
    gap: var(--space-2);
    align-content: center;
    border-top: 1px solid var(--line);
    padding-top: var(--space-5);
  }

  .traffic-compare article:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .traffic-compare span {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .traffic-compare strong {
    color: var(--ink);
    font-size: clamp(2rem, 8vw, 4rem);
    line-height: 1;
  }

  .traffic-compare p {
    color: var(--ink-soft);
    font-size: clamp(1.35rem, 4vw, 2.05rem);
    font-weight: 800;
  }

  .contact-metric {
    display: inline-block;
    font-style: normal;
    font-weight: 950;
    line-height: 1;
  }

  .contact-metric--low {
    color: #a83d34;
  }

  .traffic-compare__winner strong {
    color: var(--sky);
  }

  .contact-metric--high {
    color: var(--olive);
  }

  .traffic-compare__versus {
    display: grid;
    place-items: center;
    align-self: center;
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 950;
    letter-spacing: 0.12em;
  }

  .section-closing {
    color: var(--ink);
    font-family: "Manrope", "Segoe UI", sans-serif;
    font-size: clamp(1.25rem, 3.6vw, 2.05rem);
    font-weight: 800;
    line-height: 1.08;
  }

  .campaign-timeline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-block: 1px solid var(--line);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .campaign-timeline li {
    position: relative;
    display: grid;
    gap: var(--space-3);
    border-bottom: 1px solid var(--line);
    padding: var(--space-5) 0;
  }

  .campaign-timeline li:last-child {
    border-bottom: 0;
  }

  .campaign-timeline span {
    color: var(--olive);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .campaign-timeline p,
  .execution-journey p,
  .editorial-grid p,
  .case-story p {
    color: var(--ink-soft);
  }

  .execution-journey {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .execution-journey::before {
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: 20px;
    width: 1px;
    background: var(--line);
    content: "";
  }

  .execution-journey li {
    position: relative;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .execution-journey span {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(31, 54, 92, 0.16);
    border-radius: 50%;
    background: var(--paper);
    color: var(--sky);
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
  }

  .execution-journey h3,
  .execution-journey p {
    grid-column: 2;
  }

  .execution-journey h3 {
    align-self: end;
  }

  .execution-journey li:last-child span {
    background: var(--olive);
    border-color: var(--olive);
    color: #fff;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-block: 1px solid var(--line);
  }

  .editorial-grid article {
    display: grid;
    gap: var(--space-3);
    border-bottom: 1px solid var(--line);
    padding: var(--space-5) 0;
  }

  .editorial-grid article:last-child {
    border-bottom: 0;
  }

  .premium-compare {
    display: grid;
    gap: var(--space-5);
    border: 1px solid rgba(31, 54, 92, 0.14);
    border-radius: 14px;
    background: var(--paper-strong);
    box-shadow: 0 10px 28px rgba(31, 54, 92, 0.025);
    overflow: hidden;
  }

  .premium-compare__side {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .premium-compare__side + .premium-compare__side {
    border-top: 1px solid rgba(31, 54, 92, 0.12);
  }

  .premium-compare ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .premium-compare li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: var(--space-3);
    border-top: 1px solid rgba(31, 54, 92, 0.1);
    color: var(--ink-soft);
    font-weight: 800;
    padding-block: var(--space-4);
  }

  .premium-compare li:last-child {
    border-bottom: 1px solid rgba(31, 54, 92, 0.1);
  }

  .premium-compare span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid currentColor;
    border-radius: 50%;
    line-height: 1;
  }

  .premium-compare__side--avoid span {
    color: #c43d32;
  }

  .premium-compare__side--do span {
    background: var(--olive);
    color: #ffffff;
  }

  .dual-channel {
    display: grid;
    gap: var(--space-4);
    border-block: 1px solid var(--line);
  }

  .dual-channel article {
    display: grid;
    gap: var(--space-3);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-5);
  }

  .dual-channel article:last-child {
    border-bottom: 0;
  }

  .dual-channel span {
    color: var(--olive);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dual-channel strong {
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .dual-channel p,
  .internal-note {
    color: var(--ink-soft);
  }

  .internal-note a {
    color: var(--ink);
    font-weight: 800;
  }

  .investment-orbit {
    position: relative;
    display: grid;
    min-height: 430px;
    place-items: center;
    isolation: isolate;
  }

  .investment-orbit::before,
  .investment-orbit::after {
    position: absolute;
    border: 1px solid rgba(31, 54, 92, 0.12);
    border-radius: 50%;
    content: "";
    z-index: -1;
  }

  .investment-orbit::before {
    width: min(72vw, 420px);
    aspect-ratio: 1;
  }

  .investment-orbit::after {
    width: min(52vw, 300px);
    aspect-ratio: 1;
    border-color: rgba(135, 191, 255, 0.38);
  }

  .investment-orbit__center,
  .investment-orbit__factor {
    display: grid;
    place-items: center;
    text-align: center;
    font-family: "Manrope", "Segoe UI", sans-serif;
    font-weight: 900;
  }

  .investment-orbit__center {
    width: clamp(148px, 38vw, 190px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: clamp(1.05rem, 3.5vw, 1.45rem);
    box-shadow: 0 22px 48px rgba(31, 54, 92, 0.14);
  }

  .investment-orbit__factor {
    position: absolute;
    min-width: 132px;
    min-height: 54px;
    padding: 0 var(--space-4);
    border: 1px solid rgba(31, 54, 92, 0.12);
    border-radius: 999px;
    background: var(--paper-strong);
    color: var(--ink);
    font-size: clamp(0.95rem, 2.6vw, 1.15rem);
    box-shadow: 0 14px 34px rgba(31, 54, 92, 0.06);
  }

  .investment-orbit__factor--top {
    top: 0;
    color: var(--sky);
  }

  .investment-orbit__factor--left {
    left: clamp(38px, calc(50% - 270px), 290px);
    top: 50%;
    transform: translateY(-50%);
  }

  .investment-orbit__factor--right {
    right: clamp(38px, calc(50% - 270px), 290px);
    top: 50%;
    transform: translateY(-50%);
    color: var(--sky);
  }

  .investment-orbit__factor--bottom {
    bottom: 0;
  }

  .trust-section {
    width: min(1120px, calc(100% - 48px));
    max-width: 1120px;
    border-radius: 18px;
    background: var(--ink);
    color: #f7f3ea;
    padding: clamp(2.25rem, 5.5vw, 4rem);
  }

  .trust-section .section-header {
    max-width: 860px;
  }

  .trust-section .eyebrow {
    color: var(--sky);
  }

  .trust-section h2,
  .trust-section h3,
  .trust-section__closing {
    color: #f7f3ea;
  }

  .trust-section .section-header p:not(.eyebrow),
  .trust-row p {
    color: rgba(247, 243, 234, 0.72);
  }

  .trust-list {
    display: grid;
    gap: 0;
    margin-top: var(--space-5);
    border-top: 1px solid rgba(247, 243, 234, 0.16);
  }

  .trust-row {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    border-bottom: 1px solid rgba(247, 243, 234, 0.16);
    padding-block: var(--space-4);
  }

  .trust-row__side {
    display: grid;
    gap: var(--space-2);
  }

  .trust-row__side h3 {
    position: relative;
    padding-left: 1rem;
    font-size: clamp(1.12rem, 2.2vw, 1.42rem);
  }

  .trust-row__side h3::before {
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: #d96557;
    content: "";
  }

  .trust-row__side--next h3::before {
    background: var(--olive);
  }

  .trust-section__closing {
    max-width: 780px;
    margin: var(--space-5) 0 0;
    border-left: 3px solid var(--olive);
    font-family: "Manrope", "Segoe UI", sans-serif;
    font-size: clamp(1rem, 2vw, 1.28rem);
    font-weight: 850;
    line-height: 1.28;
    padding-left: var(--space-4);
  }

  .case-story {
    display: grid;
    gap: var(--space-4);
  }

  .case-story article {
    display: grid;
    gap: var(--space-3);
    border-left: 4px solid var(--olive);
    background: var(--paper-strong);
    padding: var(--space-5);
  }

  .case-story span {
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .faq-list {
    display: grid;
    gap: var(--space-3);
  }

  details {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    padding: var(--space-4);
  }

  summary {
    cursor: pointer;
    color: var(--ink);
    font-weight: 800;
  }

  details p {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .final-cta {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    border: 1px solid var(--ink);
    border-radius: var(--radius-card);
    margin-block: var(--space-8);
    background: var(--ink);
    color: #ffffff;
    padding: var(--space-6);
  }

  .final-cta__copy {
    display: grid;
    gap: var(--space-4);
  }

  .final-cta h2 {
    color: #ffffff;
    max-width: 16ch;
  }

  .final-cta p:not(.eyebrow) {
    max-width: 690px;
    color: rgba(255, 255, 255, 0.74);
  }

  .diagnostic-form {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-card);
    background: rgba(255, 250, 240, 0.07);
    padding: var(--space-5);
  }

  .diagnostic-form label {
    display: grid;
    gap: var(--space-2);
    color: #ffffff;
    font-weight: 800;
  }

  .diagnostic-form small {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .diagnostic-form input,
  .diagnostic-form textarea {
    width: 100%;
    min-height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-button);
    background: #ffffff;
    color: var(--ink);
    padding: var(--space-3) var(--space-4);
  }

  .diagnostic-form textarea {
    min-height: 112px;
    resize: vertical;
  }

  .diagnostic-form .cta-button {
    width: 100%;
    box-shadow: none;
  }

  .diagnostic-form > p {
    color: rgba(255, 255, 255, 0.72);
    font-weight: 800;
    text-align: center;
  }

  .site-footer {
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid var(--line);
    padding-block: var(--space-7);
  }

  .site-footer p {
    color: var(--ink-soft);
  }

  @media (max-width: 767px) {
    .site-header,
    .hero,
    .final-cta,
    .site-footer,
    .section {
      width: calc(100% - 40px);
      max-width: none;
    }

    .site-header {
      flex-wrap: wrap;
    }

    .hero {
      padding-top: var(--space-5);
    }

    .hero h1 {
      max-width: 12ch;
      font-size: 2rem;
      line-height: 1.12;
    }

    .hero__copy,
    .section-header,
    .case-study__intro {
      max-width: 32ch;
    }

    .hero__lead {
      max-width: 31ch;
      font-size: 1rem;
    }

    .hero__actions .cta-button {
      width: calc(100% - 8px);
    }

    .ads-hero-media {
      width: calc(100vw - 56px);
      max-width: 100%;
      justify-self: start;
    }

    .ads-hero-media img {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .investment-orbit {
      min-height: 360px;
    }

    .investment-orbit::before {
      width: min(88vw, 300px);
    }

    .investment-orbit::after {
      width: min(62vw, 210px);
    }

    .investment-orbit__center {
      width: 118px;
      font-size: 0.95rem;
    }

    .investment-orbit__factor {
      min-width: 104px;
      min-height: 46px;
      padding: 0 var(--space-3);
      font-size: 0.82rem;
    }

    .investment-orbit__factor--left {
      left: 38px;
    }

    .investment-orbit__factor--right {
      right: 38px;
    }
  }

  @media (min-width: 640px) {
    .traffic-compare {
      grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr);
      align-items: center;
    }

    .traffic-compare article,
    .traffic-compare article:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .campaign-timeline,
    .editorial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .campaign-timeline li,
    .editorial-grid article {
      border-bottom: 0;
      padding: var(--space-5);
    }

    .campaign-timeline li:nth-child(2n),
    .editorial-grid article:nth-child(2n) {
      border-left: 1px solid var(--line);
    }

    .campaign-timeline li:nth-child(n + 3),
    .editorial-grid article:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .premium-compare {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    .premium-compare__side + .premium-compare__side {
      border-top: 0;
      border-left: 1px solid rgba(31, 54, 92, 0.12);
    }

    .dual-channel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dual-channel article {
      border-bottom: 0;
      padding: var(--space-5);
    }

    .dual-channel article + article {
      border-left: 1px solid var(--line);
    }
  }

  @media (min-width: 900px) {
    body {
      font-size: 1.07rem;
    }

    h1 {
      font-size: 4.25rem;
    }

    h2 {
      font-size: 3.8rem;
    }

    h3 {
      font-size: 1.48rem;
    }

    nav,
    .site-header .cta-button {
      display: inline-flex;
    }

    .hero {
      grid-template-columns: minmax(0, 1.03fr) minmax(390px, 0.97fr);
      gap: var(--space-9);
      align-items: start;
      min-height: 760px;
      padding-block: var(--space-7) var(--space-10);
    }

    .ads-hero-media {
      align-self: start;
      width: 130%;
      justify-self: center;
      padding-top: calc(0.78rem * 1.62 + var(--space-5));
    }

    .hero__lead {
      font-size: 1.2rem;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
    }

    .section {
      padding-block: var(--space-9);
    }

    .campaign-timeline {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .campaign-timeline li,
    .campaign-timeline li:nth-child(n + 3) {
      border-top: 0;
    }

    .campaign-timeline li + li {
      border-left: 1px solid var(--line);
    }

    .campaign-timeline li::after {
      position: absolute;
      top: var(--space-6);
      right: -7px;
      z-index: 1;
      width: 12px;
      height: 12px;
      border-top: 1px solid var(--line);
      border-right: 1px solid var(--line);
      background: var(--paper);
      content: "";
      transform: rotate(45deg);
    }

    .campaign-timeline li:last-child::after {
      content: none;
    }

    .execution-journey {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .execution-journey::before {
      top: calc(var(--space-5) + 20px);
      right: calc(var(--space-5) + 21px);
      bottom: auto;
      left: calc(var(--space-5) + 21px);
      width: auto;
      height: 1px;
    }

    .execution-journey li {
      grid-template-columns: 1fr;
      align-content: start;
      gap: var(--space-4);
      padding: var(--space-5) 0 0;
    }

    .execution-journey h3,
    .execution-journey p {
      grid-column: auto;
    }

    .trust-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: var(--space-6);
    }

    .editorial-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .editorial-grid article,
    .editorial-grid article:nth-child(n + 3) {
      border-top: 0;
