---
import SiteNavigation from "../components/SiteNavigation.astro";
import CtaButton from "../components/CtaButton.astro";
import SeoHead from "../components/SeoHead.astro";
import { CONTACT_EMAIL, WHATSAPP_HREF, absoluteUrl } from "../config/site.js";

const problemSignals = [
  {
    title: "Informação espalhada",
    text: "Dados importantes ficam divididos entre planilhas, mensagens e diferentes ferramentas.",
  },
  {
    title: "Trabalho repetitivo",
    text: "A equipe executa manualmente tarefas que poderiam acontecer automaticamente.",
  },
  {
    title: "Falta de visibilidade",
    text: "É difícil acompanhar status, responsáveis, prazos e resultados em um único lugar.",
  },
  {
    title: "Ferramentas que não conversam",
    text: "A operação depende de vários sistemas sem um fluxo claro entre eles.",
  },
];

const possibilities = [
  {
    title: "CRM personalizado",
    text: "Organize leads, clientes, histórico e etapas comerciais de acordo com o seu processo.",
  },
  {
    title: "Gestão de processos",
    text: "Centralize tarefas, responsáveis, status e informações da operação.",
  },
  {
    title: "Portais internos",
    text: "Crie ambientes para equipe, parceiros ou clientes acessarem informações e serviços.",
  },
  {
    title: "Automação de tarefas",
    text: "Reduza atividades repetitivas conectando etapas que hoje dependem de ação manual.",
  },
  {
    title: "Dashboards",
    text: "Transforme dados dispersos em informações que podem ser acompanhadas.",
  },
  {
    title: "Sistemas específicos",
    text: "Quando uma ferramenta pronta não resolve o processo, desenvolvemos uma solução voltada à necessidade.",
  },
];

const processSteps = [
  {
    step: "01",
    title: "Entender",
    text: "Mapeamos o processo atual, as pessoas envolvidas e onde estão os principais gargalos.",
  },
  {
    step: "02",
    title: "Simplificar",
    text: "Antes de automatizar, eliminamos etapas desnecessárias e organizamos o fluxo.",
  },
  {
    step: "03",
    title: "Construir",
    text: "Transformamos o processo definido em uma ferramenta simples de utilizar.",
  },
  {
    step: "04",
    title: "Evoluir",
    text: "Acompanhamos o uso e identificamos melhorias conforme a operação amadurece.",
  },
];

const makesSense = [
  "o processo é específico",
  "existe muito trabalho manual",
  "informações ficam espalhadas",
  "ferramentas atuais limitam a operação",
  "existe necessidade de integração",
];

const doesNotMakeSense = [
  "uma ferramenta pronta já resolve bem",
  "o processo ainda muda toda semana",
  "o problema ainda não está claramente definido",
  "desenvolver custaria mais do que o problema gera",
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Criação de Sistemas Sob Medida",
  provider: {
    "@type": "Organization",
    name: "ConverteUp",
    url: absoluteUrl("/"),
  },
  areaServed: "BR",
  serviceType: "Criação de sistemas sob medida e automação de processos",
  description:
    "Criamos sistemas sob medida para organizar processos, automatizar tarefas e substituir operações manuais por ferramentas pensadas para sua empresa.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Criação de Sistemas",
      item: absoluteUrl("/criacao-de-sistemas"),
    },
  ],
};

const pageTitle = "Criação de Sistemas Sob Medida | ConverteUp";
const pageDescription =
  "Criamos sistemas sob medida para organizar processos, automatizar tarefas e substituir operações manuais por ferramentas pensadas para sua empresa.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead title={pageTitle} description={pageDescription} schema={[serviceSchema, breadcrumbSchema]} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <SiteNavigation />
      <CtaButton href={WHATSAPP_HREF} label="Solicitar diagnóstico" variant="secondary" />
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">CRIAÇÃO DE SISTEMAS</p>
          <h1 id="hero-title">
            Sistemas para automatizar processos da sua empresa.
          </h1>
          <p class="hero__lead">
            Criamos sistemas pensados para a operação da sua empresa — organizando informações,
            automatizando tarefas e transformando processos repetitivos em fluxos mais simples.
          </p>
          <div class="hero__actions">
            <CtaButton href={WHATSAPP_HREF} label="Quero avaliar meu processo" />
          </div>
          <ul class="hero__signals" aria-label="Prioridades do sistema">
            <li>Automação</li>
            <li>Controle</li>
            <li>Integração</li>
            <li>Eficiência</li>
          </ul>
        </div>

        <aside class="operation-system" aria-label="Representação visual de sistema empresarial">
          <div class="software-window" aria-hidden="true">
            <div class="software-window__bar">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="software-app">
              <div class="software-sidebar">
                <strong>Operação</strong>
                <span class="is-active"></span>
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="software-main">
                <div class="software-topline">
                  <span></span>
                  <small>Hoje</small>
                </div>
                <div class="software-metrics">
                  <span><strong></strong><i></i></span>
                  <span><strong></strong><i></i></span>
                  <span><strong></strong><i></i></span>
                </div>
                <div class="software-workflow">
                  <div class="workflow-list">
                    <span><i></i><b></b><em></em></span>
                    <span><i></i><b></b><em></em></span>
                    <span><i></i><b></b><em></em></span>
                    <span><i></i><b></b><em></em></span>
                  </div>
                  <div class="workflow-chart">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <section class="section problem-section" id="problema" aria-labelledby="problem-title">
        <div class="section-header">
          <p class="eyebrow">O PROBLEMA</p>
          <h2 id="problem-title">Quando a operação cresce, o improviso começa a custar caro.</h2>
        </div>
        <div class="problem-grid" aria-label="Sinais de operação improvisada">
          {problemSignals.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section transformation" id="transformacao" aria-labelledby="transform-title">
        <div class="section-header">
          <p class="eyebrow">ANTES → DEPOIS</p>
          <h2 id="transform-title">Seu processo primeiro. O sistema depois.</h2>
          <p>
            Em vez de adaptar sua operação a várias ferramentas, criamos um sistema que centraliza
            o que realmente importa.
          </p>
        </div>
        <div class="process-shift" aria-label="Comparação entre processo fragmentado e sistema organizado">
          <article class="fragmented-side comparison-panel">
            <span class="side-label">ANTES</span>
            <div class="fragment-map" aria-label="Ferramentas desconectadas">
              <span class="tool-node tool-node--sheet">Planilha</span>
              <span class="tool-node tool-node--whatsapp">WhatsApp</span>
              <span class="tool-node tool-node--email">E-mail</span>
              <span class="tool-node tool-node--tasks">Tarefas</span>
              <span class="tool-node tool-node--reports">Relatórios</span>
              <span class="fragment-line fragment-line--a" aria-hidden="true"></span>
              <span class="fragment-line fragment-line--b" aria-hidden="true"></span>
              <span class="fragment-line fragment-line--c" aria-hidden="true"></span>
            </div>
            <ul class="shift-outcomes shift-outcomes--muted">
              <li>Informação espalhada</li>
              <li>Retrabalho</li>
              <li>Processo manual</li>
            </ul>
          </article>
          <article class="connected-side comparison-panel">
            <span class="side-label">DEPOIS</span>
            <div class="system-card">
              <strong>SEU SISTEMA</strong>
              <div class="system-modules">
                <span>Clientes</span>
                <span>Processos</span>
                <span>Tarefas</span>
                <span>Dados</span>
                <span>Relatórios</span>
                <span>Automação</span>
              </div>
            </div>
            <ul class="shift-benefits">
              <li>Operação centralizada</li>
              <li>Dados conectados</li>
              <li>Processo organizado</li>
            </ul>
          </article>
          <p class="shift-summary">Várias ferramentas <span>→</span> uma operação centralizada</p>
        </div>
      </section>

      <section class="section possibilities-section" id="possibilidades" aria-labelledby="possibilities-title">
        <div class="section-header">
          <p class="eyebrow">POSSIBILIDADES</p>
          <h2 id="possibilities-title">O que podemos transformar em sistema.</h2>
          <p>
            Nem todo negócio precisa da mesma ferramenta. O sistema deve nascer do problema que
            precisa ser resolvido.
          </p>
        </div>
        <div class="possibilities-grid" aria-label="Exemplos de sistemas sob medida">
          {possibilities.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section process-section" aria-labelledby="process-title">
        <div class="section-header">
          <p class="eyebrow">PROCESSO</p>
          <h2 id="process-title">Primeiro entendemos o processo. Depois pensamos no sistema.</h2>
        </div>
        <ol class="process-line" aria-label="Etapas de criação de sistemas">
          {processSteps.map((item) => (
            <li>
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section criteria-section" id="criterio" aria-labelledby="criteria-title">
        <div class="section-header">
          <p class="eyebrow">CRITÉRIO</p>
          <h2 id="criteria-title">Nem todo problema precisa de um sistema próprio.</h2>
          <p>
            Se uma ferramenta pronta resolver bem o processo, criar software do zero pode ser
            desperdício. O desenvolvimento faz sentido quando a operação possui necessidades
            específicas, processos difíceis de adaptar ou trabalho manual que realmente justifica a
            solução.
          </p>
        </div>
        <div class="criteria-compare" aria-label="Critérios para avaliar um sistema próprio">
          <article class="criteria-compare__side criteria-compare__side--fit">
            <h3>Faz sentido quando</h3>
            <ul>
              {makesSense.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="criteria-compare__side criteria-compare__side--wait">
            <h3>Não faz sentido quando</h3>
            <ul>
              {doesNotMakeSense.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section class="final-cta" id="diagnostico" aria-labelledby="cta-title">
        <div class="final-cta__copy">
          <p class="eyebrow">DIAGNÓSTICO</p>
          <h2 id="cta-title">Existe um processo na sua empresa que deveria funcionar melhor?</h2>
          <p>
            Conte como ele funciona hoje. Podemos analisar se faz sentido organizar, automatizar ou
            transformar esse processo em um sistema.
          </p>
          <div class="final-cta__action">
            <CtaButton
              href={`mailto:${CONTACT_EMAIL}?subject=Avaliar%20processo%20para%20cria%C3%A7%C3%A3o%20de%20sistema`}
              label="Avaliar meu processo"
              dataCta="email"
              dataConversion="primary-cta"
            />
            <small>Sem compromisso. Primeiro entendemos o problema.</small>
          </div>
        </div>
        <aside class="diagnostic-panel" aria-label="O que podemos analisar no diagnóstico">
          <h3>O que podemos analisar</h3>
          <ol>
            <li>
              <div>
                <strong>Processo</strong>
                <p>Onde existem etapas desnecessárias.</p>
              </div>
            </li>
            <li>
              <div>
                <strong>Ferramentas</strong>
                <p>Onde informações ficam espalhadas.</p>
              </div>
            </li>
            <li>
              <div>
                <strong>Trabalho manual</strong>
                <p>O que pode ser automatizado.</p>
              </div>
            </li>
            <li>
              <div>
                <strong>Dados</strong>
                <p>O que poderia estar centralizado.</p>
              </div>
            </li>
          </ol>
        </aside>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <p>
        SEO, Google Ads, criação de sites e sistemas para empresas que precisam transformar procura,
        processos e dados em crescimento.
      </p>
      <a class="text-link" href={WHATSAPP_HREF}>Avaliar processo</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #183153;
    --ink-soft: rgba(31, 54, 92, 0.76);
    --ink-muted: rgba(31, 54, 92, 0.56);
    --paper: #eeebd3;
    --paper-strong: #faf8ea;
    --panel: rgba(255, 250, 240, 0.9);
    --olive: #679436;
    --moss: #5c946e;
    --line: rgba(31, 54, 92, 0.15);
    --shadow: 0 16px 42px rgba(31, 54, 92, 0.08);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    color: var(--ink);
    background: var(--paper);
    font-size: 1rem;
    line-height: 1.62;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3,
  strong {
    font-family: "Manrope", "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  h1 {
    max-width: 13ch;
    color: var(--ink);
    font-size: 2.26rem;
    font-weight: 800;
    line-height: 1.02;
  }

  h2 {
    max-width: 14ch;
    color: var(--ink);
    font-size: 2.16rem;
    font-weight: 800;
    line-height: 1.02;
  }

  h3 {
    color: var(--ink);
    font-size: 1.24rem;
    font-weight: 800;
    line-height: 1.12;
  }

  a {
    color: inherit;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 20;
    transform: translateY(-160%);
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: var(--olive);
    color: #ffffff;
    padding: var(--space-3) var(--space-4);
    font-weight: 800;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  .hero,
  .section,
  .final-cta,
  .site-footer {
    width: calc(100% - 40px);
    max-width: 1180px;
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--olive);
    color: #ffffff;
    font-size: 0.95rem;
  }

  nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  nav a,
  .text-link,
  .site-footer a:not(.brand) {
    color: var(--ink-soft);
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  .text-link:hover,
  .site-footer a:not(.brand):hover {
    color: var(--ink);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--olive);
    box-shadow: 6px 6px 0 var(--ink);
    color: #ffffff;
    font-weight: 800;
    line-height: 1.15;
    padding: var(--space-3) var(--space-5);
    text-align: center;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .cta-button:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .cta-button--secondary {
    background: var(--paper-strong);
    box-shadow: none;
    color: var(--ink);
  }

  .site-header .cta-button {
    display: none;
  }

  .cta-button:focus-visible,
  a:focus-visible {
    outline: 3px solid rgba(111, 153, 52, 0.42);
    outline-offset: 4px;
  }

  .eyebrow {
    color: var(--moss);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-7) var(--space-9);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__lead {
    max-width: 61ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.62;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    align-items: center;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__signals li {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__signals li + li::before {
    content: "/";
    margin-inline: var(--space-3);
    color: var(--olive);
  }

  .operation-system {
    min-width: 0;
    margin: 0;
  }

  .software-window {
    display: grid;
    overflow: hidden;
    width: min(100%, 640px);
    margin-inline: auto;
    border: 1px solid var(--ink);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    box-shadow: 10px 10px 0 rgba(111, 153, 52, 0.5);
  }

  .software-window__bar {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    background: rgba(31, 54, 92, 0.04);
    padding-inline: var(--space-5);
  }

  .software-window__bar span {
    width: 10px;
    height: 10px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }

  .software-window__bar span:first-child {
    background: var(--olive);
  }

  .software-app {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    min-height: 360px;
  }

  .software-sidebar {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    border-right: 1px solid var(--line);
    background: rgba(31, 54, 92, 0.035);
    padding: var(--space-5) var(--space-4);
  }

  .software-sidebar strong {
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.1;
  }

  .software-sidebar span {
    display: block;
    width: 100%;
    height: 12px;
    border-radius: 999px;
    background: rgba(31, 54, 92, 0.13);
  }

  .software-sidebar .is-active {
    background: var(--olive);
  }

  .software-main {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
    padding: var(--space-5);
  }

  .software-topline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
  }

  .software-topline span {
    width: min(100%, 260px);
    height: 20px;
    border-radius: 999px;
    background: rgba(31, 54, 92, 0.16);
  }

  .software-topline small {
    border: 1px solid rgba(31, 54, 92, 0.16);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 900;
    padding: var(--space-1) var(--space-3);
    text-transform: uppercase;
  }

  .software-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .software-metrics span {
    display: grid;
    gap: var(--space-3);
    min-height: 78px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
