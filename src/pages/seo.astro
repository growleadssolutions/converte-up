---
import CtaButton from "../components/CtaButton.astro";
import SeoHead from "../components/SeoHead.astro";
import { CONTACT_EMAIL, WHATSAPP_HREF, absoluteUrl } from "../config/site.js";

const problemItems = [
  "O site aparece apenas pelo nome da empresa",
  "Os serviços não possuem páginas próprias",
  "O conteúdo não responde às pesquisas dos clientes",
  "O Google não entende onde a empresa atende",
  "Existem impressões, mas poucos cliques e contatos",
];

const beforeItems = [
  "Site aparece apenas pelo nome",
  "Serviços concentrados em uma única página",
  "Conteúdo sem intenção definida",
  "Dependência de indicação ou anúncio",
  "Decisões feitas sem dados",
];

const afterItems = [
  "Páginas preparadas para buscas comerciais",
  "Estrutura por serviço, cidade ou necessidade",
  "Conteúdo que responde dúvidas reais",
  "Tráfego orgânico crescendo como novo canal",
  "Melhorias orientadas por cliques, posições e contatos",
];

const seoFlow = [
  {
    step: "01",
    title: "Procura",
    text: "O cliente pesquisa um serviço, problema, produto ou localização.",
  },
  {
    step: "02",
    title: "Encontro",
    text: "O Google identifica páginas relevantes e apresenta as melhores respostas.",
  },
  {
    step: "03",
    title: "Decisão",
    text: "O visitante entende a oferta, encontra confiança e avalia o próximo passo.",
  },
  {
    step: "04",
    title: "Contato",
    text: "A página conduz para WhatsApp, ligação, formulário ou visita.",
  },
];

const strategyItems = [
  {
    title: "SEO técnico",
    text: "Organizamos headings, metadados, links internos, indexação, velocidade e leitura pelos buscadores.",
  },
  {
    title: "Páginas comerciais",
    text: "Criamos páginas específicas para serviços, produtos, cidades e pesquisas com intenção de compra.",
  },
  {
    title: "SEO local",
    text: "Conectamos site, localização e Perfil da Empresa no Google para fortalecer buscas próximas.",
  },
  {
    title: "Conteúdo estratégico",
    text: "Produzimos conteúdos que respondem dúvidas, ampliam autoridade e apoiam as páginas comerciais.",
  },
];

const localItems = [
  {
    title: "Google Business",
    text: "Categorias, serviços, informações, avaliações e consistência do perfil.",
  },
  {
    title: "Páginas por serviço e cidade",
    text: "Estrutura para o Google relacionar a oferta com a localização atendida.",
  },
  {
    title: "Relevância local",
    text: "Conteúdo, sinais de confiança e informações coerentes em toda a presença digital.",
  },
];

const methodSteps = [
  {
    title: "Diagnóstico",
    text: "Analisamos mercado, concorrentes, páginas atuais e oportunidades de busca.",
  },
  {
    title: "Pesquisa",
    text: "Mapeamos palavras-chave pela intenção, dificuldade e valor comercial.",
  },
  {
    title: "Arquitetura",
    text: "Definimos quais páginas precisam existir e como elas devem se conectar.",
  },
  {
    title: "Implementação",
    text: "Aplicamos SEO técnico, copy, conteúdo e sinais locais.",
  },
  {
    title: "Evolução",
    text: "Acompanhamos cliques, impressões, posições e conversões para priorizar melhorias.",
  },
];

const faqs = [
  {
    question: "O que é SEO?",
    answer:
      "SEO é o trabalho de preparar site, páginas, conteúdo e presença local para que o Google entenda melhor uma empresa. O objetivo é aproximar a busca do cliente de uma página capaz de responder e gerar contato.",
  },
  {
    question: "Quanto tempo o SEO leva para gerar resultados?",
    answer:
      "Depende da concorrência, do histórico do domínio, da qualidade atual do site e da quantidade de páginas necessárias. Ajustes técnicos podem aparecer antes, mas crescimento orgânico costuma ser progressivo.",
  },
  {
    question: "SEO funciona para pequenas empresas?",
    answer:
      "Sim, principalmente quando existe busca local pelo serviço. Para pequenas empresas, SEO costuma conectar páginas por serviço, localização, Perfil da Empresa no Google e conteúdo útil.",
  },
  {
    question: "Qual é a diferença entre SEO e Google Ads?",
    answer:
      "Google Ads compra visibilidade enquanto há investimento na campanha. SEO constrói relevância orgânica com páginas, conteúdo e sinais técnicos. Os dois canais podem trabalhar juntos.",
  },
  {
    question: "O que é SEO local?",
    answer:
      "SEO local foca em pesquisas próximas, como serviços por cidade, bairro ou região atendida. Ele envolve site, páginas locais, Perfil da Empresa no Google e consistência das informações.",
  },
  {
    question: "Preciso criar um site novo para fazer SEO?",
    answer:
      "Nem sempre. Se a base atual permite melhorias, é possível ajustar estrutura, conteúdo e páginas. Quando o site limita velocidade, indexação ou conversão, refazer pode ser o caminho mais eficiente.",
  },
  {
    question: "A ConverteUp produz conteúdos para blog?",
    answer:
      "Sim. O conteúdo é planejado para responder dúvidas reais e apoiar páginas comerciais, não apenas preencher o blog com textos soltos.",
  },
  {
    question: "É possível garantir a primeira posição no Google?",
    answer:
      "Não. Nenhuma empresa controla completamente o algoritmo, a concorrência ou o comportamento de busca. O trabalho correto é construir uma base consistente e acompanhar evolução com dados.",
  },
  {
    question: "Como os resultados de SEO são acompanhados?",
    answer:
      "Acompanhamos impressões, cliques, posições, páginas que recebem visitas e caminhos que geram contato. Esses dados ajudam a decidir quais melhorias devem vir primeiro.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SEO para empresas e tráfego orgânico",
  provider: {
    "@type": "Organization",
    name: "ConverteUp",
    url: absoluteUrl("/"),
  },
  areaServed: "BR",
  serviceType: "SEO, SEO local, tráfego orgânico e páginas por serviço",
  description:
    "Estratégias de SEO, SEO local, páginas por serviço e conteúdo para ajudar empresas a aparecerem no Google e gerarem oportunidades comerciais.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "SEO",
      item: absoluteUrl("/seo"),
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const pageTitle = "SEO para empresas | Tráfego orgânico e SEO local | ConverteUp";
const pageDescription =
  "Estratégias de SEO, SEO local, páginas por serviço e conteúdo para ajudar sua empresa a aparecer no Google e gerar mais oportunidades.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      ogDescription="SEO local, conteúdo e estrutura técnica para transformar pesquisas no Google em visitas, contatos e oportunidades comerciais."
      schema={[serviceSchema, breadcrumbSchema, faqSchema]}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <nav>
        <a href="/seo/">SEO</a>
        <a href="/google-ads/">Google Ads</a>
        <a href="/criacao-de-sites/">Criação de Sites</a>
        <a href="/contato/">Contato</a>
      </nav>
      <CtaButton href={WHATSAPP_HREF} label="Solicitar diagnóstico" variant="secondary" />
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">SEO E TRÁFEGO ORGÂNICO</p>
          <h1 id="hero-title">Sua empresa precisa aparecer quando o cliente procura.</h1>
          <p class="hero__lead">
            O Google já recebe todos os dias pesquisas pelos serviços que sua empresa oferece. O
            trabalho de SEO organiza páginas, conteúdo e presença local para transformar parte dessa
            procura em visitas, contatos e oportunidades comerciais. As imagens desta página mostram
            parte do case da Reecell.
          </p>
          <div class="hero__actions">
            <CtaButton href={WHATSAPP_HREF} label="Quero aparecer no Google" />
          </div>
          <ul class="hero__signals" aria-label="Frentes do SEO">
            <li>SEO LOCAL</li>
            <li>PÁGINAS POR SERVIÇO</li>
            <li>CONTEÚDO</li>
            <li>DADOS</li>
          </ul>
        </div>

        <figure class="seo-hero-media" aria-label="Visual de SEO e crescimento orgânico">
          <img
            src="/Image/Hero/Seo-hero.webp"
            alt="Painel visual representando SEO, buscas no Google e crescimento de oportunidades orgânicas"
            width="900"
            height="760"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </section>

      <section class="section problem" id="problema" aria-labelledby="problem-title">
        <div class="problem__copy">
          <p class="eyebrow">O PROBLEMA</p>
          <h2 id="problem-title">Ter um site não significa ser encontrado.</h2>
          <p>
            Muitas empresas publicam um site e esperam que o Google comece a enviar clientes. Mas,
            sem páginas específicas, conteúdo útil, estrutura técnica e sinais locais, o site pode
            existir por anos sem participar da aquisição.
          </p>
        </div>
        <aside class="problem-list" aria-label="Sinais de que o site não participa da busca">
          {problemItems.map((item) => <span>{item}</span>)}
        </aside>
      </section>

      <section class="section strategy-shift" aria-labelledby="before-after-title">
        <div class="strategy-shift__header">
          <p class="eyebrow">ANTES E DEPOIS</p>
          <h2 id="before-after-title">O que muda quando existe uma estratégia de busca.</h2>
        </div>
        <div class="comparison-board" aria-label="Comparativo antes e depois da estratégia de SEO">
          <div class="comparison-board__head" aria-hidden="true">
            <span>Antes</span>
            <span>Depois</span>
          </div>
          <ul>
            {beforeItems.map((item, index) => (
              <li>
                <p class="comparison-item comparison-item--before">
                  <span aria-hidden="true">x</span>
                  {item}
                </p>
                <p class="comparison-item comparison-item--after">
                  <span aria-hidden="true">✓</span>
                  {afterItems[index]}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section flow-section" id="como-funciona" aria-labelledby="flow-title">
        <div class="section-header">
          <p class="eyebrow">COMO FUNCIONA</p>
          <h2 id="flow-title">Da pesquisa do cliente ao contato com a empresa.</h2>
          <p>
            SEO conecta o que as pessoas pesquisam com páginas capazes de responder, convencer e
            conduzir para o próximo passo.
          </p>
        </div>
        <ol class="seo-flow" aria-label="Fluxo do SEO até o contato">
          {seoFlow.map((item) => (
            <li>
              <span>{item.step}</span>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section strategy-fronts" id="estrategia" aria-labelledby="strategy-title">
        <div class="section-header">
          <p class="eyebrow">ESTRATÉGIA</p>
          <h2 id="strategy-title">SEO funciona quando várias frentes trabalham juntas.</h2>
          <p>
            Não existe uma única configuração capaz de resolver tudo. O resultado depende da conexão
            entre estrutura, conteúdo, presença local e acompanhamento.
          </p>
        </div>
        <div class="seo-strategy-table" aria-label="Comparativo entre site sem SEO e site estruturado com SEO">
          <article class="seo-strategy-table__column seo-strategy-table__column--weak">
            <h3>Site sem SEO</h3>
            <ul>
              <li>Não atrai clientes de forma previsível.</li>
              <li>Não tem estrutura para aparecer nas buscas.</li>
              <li>Recebe poucos contatos qualificados.</li>
              <li>É apenas um site bonito, sem função comercial clara.</li>
            </ul>
          </article>
          <article class="seo-strategy-table__column seo-strategy-table__column--strong">
            <h3>Site estruturado com SEO</h3>
            <ul>
              <li>Tem estrutura pensada para busca, leitura e conversão.</li>
              <li>Atrai clientes com intenção real de compra.</li>
              <li>Gera mais contatos e oportunidades comerciais.</li>
              <li>Entrega mais valor porque conecta design, conteúdo e estratégia.</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="section local-section" id="seo-local" aria-labelledby="local-title">
        <div class="local-section__copy">
          <p class="eyebrow">SEO LOCAL</p>
          <h2 id="local-title">Ser encontrado por quem está perto e pronto para comprar.</h2>
          <p>
            Para empresas locais, a disputa acontece no mapa, nos resultados orgânicos e nas páginas
            que explicam cada serviço. O objetivo é aumentar a presença nas pesquisas que realmente
            podem gerar ligação, rota, WhatsApp ou visita.
          </p>
        </div>
        <figure class="local-visual" aria-label="Visual de SEO local">
          <img
            src="/Image/Hero/Seo-local-img.webp"
            alt="Representação visual de SEO local conectando buscas próximas, mapa e presença da empresa"
            width="900"
            height="620"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="local-list">
          {localItems.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section method" aria-labelledby="method-title">
        <div class="section-header">
          <p class="eyebrow">NOSSO MÉTODO</p>
          <h2 id="method-title">SEO sem achismo, promessa vazia ou conteúdo aleatório.</h2>
        </div>
        <ol class="method-list" aria-label="Método de SEO da ConverteUp">
          {methodSteps.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="section expectation" aria-labelledby="expectation-title">
        <div class="section-header">
          <p class="eyebrow">EXPECTATIVA</p>
          <h2 id="expectation-title">SEO constrói resultado com consistência, não de um dia para o outro.</h2>
          <p>
            O tempo depende da concorrência, do histórico do domínio, da qualidade atual do site e
            da quantidade de páginas que precisam ser desenvolvidas. Algumas melhorias técnicas
            podem aparecer rapidamente, enquanto o crescimento orgânico costuma acontecer de forma
            progressiva.
          </p>
        </div>
        <div class="channel-compare">
          <article>
            <h3>Google Ads</h3>
            <p>Pode gerar visibilidade imediatamente enquanto houver investimento.</p>
            <a href="/google-ads">Ver página de Google Ads</a>
          </article>
          <article>
            <h3>SEO</h3>
            <p>
              Constrói relevância e tráfego de forma progressiva, com potencial de gerar retorno por
              mais tempo.
            </p>
          </article>
        </div>
      </section>

      <section class="section case-study" id="resultados" aria-labelledby="case-title">
        <div class="case-study__intro">
          <p class="eyebrow">CASE REECELL</p>
          <h2 id="case-title">De uma vitrine escondida para uma presença local em crescimento.</h2>
        </div>
        <div class="case-story">
          <article>
            <span>Contexto</span>
            <p>
              A Reecell já possuía clientes satisfeitos, mas dependia muito de indicação e tinha
              pouca presença nas buscas locais.
            </p>
          </article>
          <article>
            <span>Estratégia</span>
            <p>
              Reestruturamos o site, criamos páginas por serviço, melhoramos o Google Business,
              publicamos conteúdo e conectamos o trabalho orgânico às campanhas.
            </p>
          </article>
          <article>
            <span>Evolução</span>
            <p>
              O site passou a receber mais de 100 visitantes por mês e ganhou posições para
              pesquisas locais importantes. Em um dos períodos acompanhados, houve crescimento de
              cliques, contatos e uma diferença relevante de faturamento, influenciada pelo conjunto
              das estratégias e por fatores externos do negócio.
            </p>
          </article>
        </div>
      </section>
      <section class="section faq" id="faq" aria-labelledby="faq-title">
        <div class="section-header">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Perguntas antes de investir em SEO.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta" id="diagnostico" aria-labelledby="diagnostic-title">
        <div class="final-cta__copy">
          <p class="eyebrow">DIAGNÓSTICO</p>
          <h2 id="diagnostic-title">Vamos descobrir o que impede sua empresa de aparecer no Google?</h2>
          <p>
            O diagnóstico inicial identifica problemas técnicos, oportunidades de páginas e buscas
            que podem aproximar sua empresa de novos clientes.
          </p>
        </div>
        <form
          class="diagnostic-form"
          action={`mailto:${CONTACT_EMAIL}`}
          method="post"
          enctype="text/plain"
          data-conversion="contact-form"
        >
          <label>
            <span>Nome</span>
            <input name="nome" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Telefone</span>
            <input name="telefone" type="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>Assunto ou mensagem <small>(opcional)</small></span>
            <textarea name="mensagem" rows="4"></textarea>
          </label>
          <button class="cta-button" type="submit" data-cta="form-submit" data-conversion="contact-form">Quero meu diagnóstico</button>
          <p>Sem compromisso • resposta pelo WhatsApp</p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <p>
        SEO, Google Ads, <a href="/criacao-de-sites/">criação de sites</a> e sistemas para empresas
        que precisam transformar procura em oportunidade comercial.
      </p>
      <a class="text-link" href={WHATSAPP_HREF}>Solicitar diagnóstico</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #183153;
    --ink-soft: rgba(24, 49, 83, 0.76);
    --ink-muted: rgba(24, 49, 83, 0.56);
    --paper: #eeebd3;
    --paper-strong: #faf8ea;
    --panel: rgba(255, 252, 246, 0.9);
    --olive: #679436;
    --moss: #5c946e;
    --line: rgba(24, 49, 83, 0.12);
    --shadow: 0 18px 50px rgba(24, 49, 83, 0.09);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    color: var(--ink);
    background: var(--paper);
    font-size: 1rem;
    line-height: 1.62;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3 {
    font-family: "Manrope", "Segoe UI", sans-serif;
    line-height: 1;
    letter-spacing: 0;
  }

  h1 {
    max-width: 13ch;
    font-size: 2.28rem;
    font-weight: 800;
  }

  h2 {
    max-width: 13ch;
    font-size: 2.18rem;
    font-weight: 800;
  }

  h3 {
    font-size: 1.35rem;
    font-weight: 800;
  }

  a {
    color: inherit;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 20;
    transform: translateY(-160%);
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: var(--olive);
    color: #ffffff;
    padding: var(--space-3) var(--space-4);
    font-weight: 800;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  .hero,
  .section,
  .final-cta,
  .site-footer {
    width: calc(100% - 40px);
    max-width: 1180px;
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--olive);
    color: #ffffff;
    font-size: 0.95rem;
  }

