---
import SiteNavigation from "../components/SiteNavigation.astro";
import CtaButton from "../components/CtaButton.astro";
import SeoHead from "../components/SeoHead.astro";
import { CONTACT_EMAIL, WHATSAPP_HREF, absoluteUrl } from "../config/site.js";

const contactEmail = CONTACT_EMAIL;
const whatsappHref = WHATSAPP_HREF;

const faqs = [
  {
    question: "O diagnóstico é pago?",
    answer:
      "Não. O diagnóstico inicial serve para entender o cenário da empresa, identificar o principal problema e apontar um caminho antes de recomendar qualquer serviço.",
  },
  {
    question: "Quanto tempo demora para responder?",
    answer:
      "Respondemos assim que possível pelo WhatsApp informado no formulário. Se a mensagem trouxer mais contexto, conseguimos orientar melhor já no primeiro retorno.",
  },
  {
    question: "Preciso saber qual serviço contratar?",
    answer:
      "Não. Você pode explicar o que quer melhorar e avaliamos se o próximo passo faz mais sentido em site, SEO, Google Ads, sistemas ou organização do processo comercial.",
  },
  {
    question: "Vocês atendem empresas fora de Curitiba?",
    answer:
      "Sim. Atendemos empresas de outras cidades e regiões. Quando fizer sentido para SEO local, analisamos também a cidade e a área de atuação da empresa.",
  },
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contato | ConverteUp",
  description:
    "Fale com a ConverteUp sobre criação de sites, SEO, Google Ads ou sistemas. Conte seu cenário e receba uma orientação inicial.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Contato",
      item: absoluteUrl("/contato"),
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const pageTitle = "Contato | ConverteUp";
const pageDescription =
  "Fale com a ConverteUp sobre criação de sites, SEO, Google Ads ou sistemas. Conte seu cenário e receba uma orientação inicial.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead title={pageTitle} description={pageDescription} schema={[contactSchema, breadcrumbSchema, faqSchema]} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <SiteNavigation />
      <CtaButton href={whatsappHref} label="Solicitar diagnóstico" variant="secondary" />
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">CONTATO</p>
          <h1 id="hero-title">Vamos entender onde sua empresa pode crescer.</h1>
          <p class="hero__lead">
            O primeiro passo é entender o cenário antes de recomendar qualquer solução.
          </p>
          <div class="hero__actions">
            <CtaButton href={whatsappHref} label="Prefiro falar pelo WhatsApp" dataCta="whatsapp" />
          </div>
        </div>

        <form
          class="contact-form"
          id="diagnostico"
          name="diagnostico"
          action={`mailto:${contactEmail}`}
          method="post"
          enctype="text/plain"
          aria-label="Formulário de diagnóstico inicial"
          data-conversion="contact-form"
        >
          <label>
            <span>Nome</span>
            <input name="nome" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Telefone</span>
            <input name="telefone" type="tel" autocomplete="tel" inputmode="tel" required />
          </label>
          <label>
            <span>Assunto <small>(opcional)</small></span>
            <select name="assunto">
              <option value="">Selecione uma opção</option>
              <option>Criação de Sites</option>
              <option>SEO</option>
              <option>Google Ads</option>
              <option>Criação de Sistemas</option>
              <option>Outro</option>
            </select>
          </label>
          <label>
            <span>Mensagem <small>(opcional)</small></span>
            <textarea
              name="mensagem"
              rows="4"
              placeholder="Conte brevemente o que você quer melhorar."
            ></textarea>
          </label>
          <button class="cta-button" type="submit" data-cta="form-submit" data-conversion="contact-form">Solicitar diagnóstico</button>
          <p>Sem compromisso. Respondemos pelo WhatsApp.</p>
        </form>
      </section>

      <section class="section faq-section" aria-labelledby="faq-title">
        <div class="section-header">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Dúvidas rápidas antes do contato.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <p>
        SEO, Google Ads, criação de sites e sistemas para empresas que precisam transformar procura,
        processos e dados em crescimento.
      </p>
      <a class="text-link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #183153;
    --ink-soft: rgba(31, 54, 92, 0.76);
    --ink-muted: rgba(31, 54, 92, 0.56);
    --paper: #eeebd3;
    --paper-strong: #faf8ea;
    --panel: rgba(255, 250, 240, 0.9);
    --olive: #679436;
    --moss: #5c946e;
    --line: rgba(31, 54, 92, 0.15);
    --shadow: 0 16px 42px rgba(31, 54, 92, 0.08);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    color: var(--ink);
    background: var(--paper);
    font-size: 1rem;
    line-height: 1.62;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3,
  strong {
    font-family: "Manrope", "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  h1 {
    max-width: 12ch;
    color: var(--ink);
    font-size: 2.32rem;
    font-weight: 800;
    line-height: 1.02;
  }

  h2 {
    max-width: 13ch;
    color: var(--ink);
    font-size: 2.12rem;
    font-weight: 800;
    line-height: 1.02;
  }

  h3 {
    color: var(--ink);
    font-size: 1.24rem;
    font-weight: 800;
    line-height: 1.12;
  }

  a {
    color: inherit;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 20;
    transform: translateY(-160%);
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: var(--olive);
    color: #ffffff;
    padding: var(--space-3) var(--space-4);
    font-weight: 800;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  .hero,
  .section,
  .site-footer {
    width: calc(100% - 40px);
    max-width: 1180px;
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--olive);
    color: #ffffff;
    font-size: 0.95rem;
  }

  nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  nav a,
  .text-link,
  .site-footer a:not(.brand) {
    color: var(--ink-soft);
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  .text-link:hover,
  .site-footer a:not(.brand):hover {
    color: var(--ink);
  }

  .cta-button,
  button.cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--olive);
    box-shadow: 6px 6px 0 var(--ink);
    color: #ffffff;
    cursor: pointer;
    font-weight: 800;
    line-height: 1.15;
    padding: var(--space-3) var(--space-5);
    text-align: center;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .cta-button:hover,
  button.cta-button:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .cta-button--secondary {
    background: var(--paper-strong);
    box-shadow: none;
    color: var(--ink);
  }

  .site-header .cta-button {
    display: none;
  }

  .cta-button:focus-visible,
  a:focus-visible,
  summary:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid rgba(111, 153, 52, 0.42);
    outline-offset: 4px;
  }

  .eyebrow {
    color: var(--moss);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
    padding-block: var(--space-7) var(--space-8);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__lead {
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.62;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .contact-form {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-strong);
    padding: var(--space-5);
  }

  .contact-form label {
    display: grid;
    gap: var(--space-2);
    color: var(--ink);
    font-weight: 800;
  }

  .contact-form small {
    color: var(--ink-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: #ffffff;
    color: var(--ink);
    padding: var(--space-3) var(--space-4);
  }

  .contact-form textarea {
    min-height: 112px;
    resize: vertical;
  }

  .contact-form input:hover,
  .contact-form select:hover,
  .contact-form textarea:hover {
    border-color: rgba(31, 54, 92, 0.32);
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(111, 153, 52, 0.18);
    outline: none;
  }

  .contact-form .cta-button {
    width: 100%;
    box-shadow: none;
  }

  .contact-form p {
    color: var(--ink-muted);
    font-size: 0.9rem;
    font-weight: 800;
    text-align: center;
  }

  .section {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .section-header {
    display: grid;
    gap: var(--space-4);
    max-width: 820px;
  }

  .section-header p:not(.eyebrow) {
    max-width: 690px;
    color: var(--ink-soft);
    font-size: 1.06rem;
    line-height: 1.68;
  }

  .faq-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
    padding: var(--space-4) 0;
  }

  summary {
    cursor: pointer;
    color: var(--ink);
    font-weight: 800;
  }

  details p {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .site-footer {
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid var(--line);
    padding-block: var(--space-7);
  }

  .site-footer p {
    max-width: 650px;
    color: var(--ink-soft);
  }

  @media (max-width: 767px) {
    .site-header,
    .hero,
    .site-footer,
    .section {
      width: calc(100% - 40px);
      max-width: none;
    }

    .site-header {
      flex-wrap: wrap;
    }

    .hero {
      padding-top: var(--space-5);
    }

    .hero h1 {
      max-width: 12ch;
      font-size: 2.04rem;
      line-height: 1.04;
    }

    .hero__copy,
    .section-header {
      max-width: 33ch;
    }

    .hero__lead {
      max-width: 31ch;
      font-size: 1rem;
    }

    .hero__actions .cta-button,
    .contact-form .cta-button {
      width: 100%;
    }

    .contact-form {
      padding: var(--space-5);
    }

  }

  @media (min-width: 900px) {
    body {
      font-size: 1.07rem;
    }

    h1 {
      font-size: 4.35rem;
    }

    h2 {
      font-size: 3.4rem;
    }

    h3 {
      font-size: 1.42rem;
    }

    nav,
    .site-header .cta-button {
      display: inline-flex;
    }

    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(390px, 0.86fr);
      gap: var(--space-9);
      min-height: 720px;
      padding-block: var(--space-7) var(--space-9);
    }

    .hero__lead {
      font-size: 1.18rem;
    }

    .contact-form {
      padding: var(--space-6);
    }

    .section {
      padding-block: var(--space-9);
    }

    .site-footer {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>
