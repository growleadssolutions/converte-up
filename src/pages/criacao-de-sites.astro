---
import CtaButton from "../components/CtaButton.astro";

const processSteps = [
  {
    step: "01",
    title: "Diagnostico",
    text: "Entendemos mercado, oferta, concorrentes, buscas e o tipo de contato que realmente vale para o negocio.",
  },
  {
    step: "02",
    title: "Arquitetura",
    text: "Organizamos paginas, secoes e caminhos para o visitante encontrar resposta sem esforco.",
  },
  {
    step: "03",
    title: "Copy",
    text: "Escrevemos a mensagem comercial para explicar valor, reduzir duvida e levar ao proximo passo.",
  },
  {
    step: "04",
    title: "Design",
    text: "Criamos uma interface clara, rapida e coerente com a decisao que o visitante precisa tomar.",
  },
  {
    step: "05",
    title: "SEO Tecnico",
    text: "Preparamos estrutura, metadados, headings, links internos, performance e leitura pelos buscadores.",
  },
  {
    step: "06",
    title: "Publicacao",
    text: "Publicamos com rastreamento, formulario, WhatsApp, analytics e pontos basicos de seguranca.",
  },
  {
    step: "07",
    title: "Evolucao",
    text: "Medimos comportamento, buscas, contatos e gargalos para melhorar o canal depois do lancamento.",
  },
];

const beforeItems = [
  "Site bonito",
  "Sem visitantes",
  "Sem SEO",
  "Cliente entra e sai",
  "Sem estrategia",
];

const afterItems = [
  "Preparado para o Google",
  "Copy orientada para conversao",
  "Mobile First",
  "Performance alta",
  "Contato simples",
];

const problemItems = [
  "O visitante entra e nao entende rapidamente o que voce faz.",
  "Seu site demora para carregar.",
  "O Google nao encontra suas paginas.",
  "Nao existe um caminho claro para contato.",
  "O visitante entra... e simplesmente vai embora.",
];

const deliverables = [
  ["SEO Tecnico", "Base para o Google entender paginas, servicos e localizacao."],
  ["Mobile First", "Layout pensado primeiro para quem decide pelo celular."],
  ["Core Web Vitals", "Estrutura estavel, rapida e confortavel para leitura."],
  ["Copy Comercial", "Texto escrito para vender o proximo passo, nao apenas preencher secao."],
  ["Google Business", "Conexao entre site, busca local e perfil da empresa."],
  ["Integracao com WhatsApp", "Contato visivel nos pontos em que a decisao costuma acontecer."],
  ["Landing Pages", "Paginas especificas para campanhas, servicos ou cidades estrategicas."],
  ["Blog otimizado", "Conteudo planejado para responder buscas e aumentar superficie organica."],
  ["Google Analytics", "Medicao de acesso, origem e comportamento dentro do site."],
  ["Microsoft Clarity", "Mapas de calor e gravacoes para encontrar atritos reais."],
  ["Estrutura escalavel", "Base preparada para novas paginas, conteudos e campanhas."],
  ["Performance elevada", "Codigo limpo, imagens leves e carregamento sem excesso de scripts."],
];

const testimonials = [
  {
    quote:
      "Quando conheci a ConverteUp, nossa assistencia tecnica tinha um site, mas ele nao ajudava a trazer clientes. O novo projeto reorganizou toda nossa presenca digital, melhorou nossa visibilidade nas buscas e hoje temos um canal preparado para crescer.",
    author: "Renata",
    role: "Proprietaria - Reecell Assistencia Tecnica",
  },
  {
    quote:
      "Precisavamos mostrar nossos servicos de forma profissional e aparecer melhor no Google. Em poucos dias apos o lancamento do novo site ja comecamos a receber contatos vindos da internet.",
    author: "Alisson",
    role: "Proprietario - Top Vip Reformas",
  },
  {
    quote:
      "A analise trouxe uma visao muito alem do design. Foram apontadas oportunidades de usabilidade, posicionamento e comunicacao que agregaram valor ao projeto.",
    author: "Equipe de projeto",
    role: "Startup participante do Shark Tank Brasil",
  },
];

const faqs = [
  {
    question: "Quanto custa criar um site profissional?",
    answer:
      "Depende da quantidade de paginas, nivel de copy, integracoes e estrategia de SEO. Antes de passar valor, avaliamos objetivo comercial, concorrencia e o que o site precisa entregar para gerar contatos qualificados.",
  },
  {
    question: "Quanto tempo demora?",
    answer:
      "O prazo depende do escopo e da velocidade de aprovacao. Uma pagina mais direta pode ser publicada rapidamente; sites com varias paginas, SEO e conteudo exigem mais planejamento.",
  },
  {
    question: "Meu site aparece no Google?",
    answer:
      "Ele ja nasce com base tecnica para indexacao: estrutura semantica, headings, metadados, links internos e performance. Posicao no Google depende de concorrencia, autoridade, conteudo e evolucao continua.",
  },
  {
    question: "Vale a pena reformular um site antigo?",
    answer:
      "Vale quando o site atual limita velocidade, clareza, SEO ou conversao. Em alguns casos, aproveitar a base e reorganizar mensagem, paginas e CTAs e suficiente.",
  },
  {
    question: "Posso contratar apenas o site?",
    answer:
      "Sim. O site pode ser contratado como projeto unico. Mesmo assim, ele sera pensado como parte de um sistema de aquisicao, preparado para receber SEO, anuncios e mensuracao depois.",
  },
  {
    question: "O site ja fica preparado para Google Ads?",
    answer:
      "Sim. A pagina pode sair com mensagem, velocidade, rastreamento e caminho de contato adequados para campanhas. Isso evita mandar trafego pago para uma pagina que nao explica nem converte.",
  },
  {
    question: "Voces fazem manutencao?",
    answer:
      "Sim. Podemos acompanhar melhorias, conteudo, ajustes tecnicos, novas paginas e leitura dos dados depois da publicacao.",
  },
  {
    question: "O site sera rapido?",
    answer:
      "A construcao prioriza performance, HTML semantico, CSS organizado, imagens leves e pouco JavaScript. A meta e entregar uma pagina rapida e confortavel no celular.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Criacao de Sites com foco em aquisicao de clientes",
  provider: {
    "@type": "Organization",
    name: "ConverteUp",
  },
  areaServed: "BR",
  serviceType: "Criacao de sites, SEO tecnico, copy comercial e landing pages",
  description:
    "Criacao de sites rapidos, mobile first e preparados para gerar contatos, orcamentos e vendas.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Criacao de sites para empresas que precisam gerar contatos, orcamentos e vendas com SEO tecnico, copy comercial, performance e WhatsApp integrado."
    />
    <meta name="theme-color" content="#1F365C" />
    <meta property="og:title" content="Criacao de Sites | ConverteUp" />
    <meta
      property="og:description"
      content="Sites rapidos, claros e preparados para transformar visitantes em oportunidades de negocio."
    />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="/criacao-de-sites" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <title>Criacao de Sites | ConverteUp</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteudo</a>

    <header class="site-header" aria-label="Navegacao principal">
      <a class="brand" href="/" aria-label="ConverteUp inicio">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <nav>
        <a href="#problema">Problema</a>
        <a href="#metodo">Metodo</a>
        <a href="#entregas">Entregas</a>
        <a href="#case">Case</a>
        <a href="#faq">FAQ</a>
      </nav>
      <CtaButton href="#diagnostico" label="Solicitar diagnostico" variant="secondary" />
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">Criacao de Sites</p>
          <h1 id="hero-title">Seu site deve trabalhar para conquistar clientes, mesmo quando voce esta dormindo.</h1>
          <p class="hero__lead">
            Hoje, muitos sites funcionam apenas como um cartao de visitas digital. Nos criamos
            paginas pensadas para aparecer nas buscas, explicar seu diferencial e transformar
            visitas em contatos reais.
          </p>
          <div class="hero__actions">
            <CtaButton href="#diagnostico" label="Solicitar diagnostico" />
          </div>
          <ul class="hero__signals" aria-label="Prioridades do projeto">
            <li>SEO</li>
            <li>Copy</li>
            <li>Performance</li>
            <li>Conversao</li>
          </ul>
        </div>

        <aside class="site-preview" aria-label="Notebook mostrando um site moderno com graficos discretos">
          <svg viewBox="0 0 720 620" role="img" aria-labelledby="preview-title preview-desc">
            <title id="preview-title">Notebook com site moderno e graficos discretos</title>
            <desc id="preview-desc">
              Tela de notebook com pagina comercial, indicador de contato e graficos ao fundo.
            </desc>
            <rect class="chart-bg chart-bg-a" x="58" y="44" width="148" height="116" rx="8"></rect>
            <rect class="chart-bg chart-bg-b" x="516" y="104" width="132" height="160" rx="8"></rect>
            <path class="chart-line" d="M82 128c30-46 62-16 92-62"></path>
            <path class="bars" d="M544 226h18v-48h-18zM576 226h18v-82h-18zM608 226h18v-116h-18z"></path>
            <rect class="browser" x="78" y="120" width="564" height="342" rx="8"></rect>
            <rect class="topbar" x="78" y="120" width="564" height="52" rx="8"></rect>
            <circle cx="112" cy="146" r="7"></circle>
            <circle cx="138" cy="146" r="7"></circle>
            <circle cx="164" cy="146" r="7"></circle>
            <rect class="headline" x="116" y="210" width="252" height="28" rx="4"></rect>
            <rect class="line" x="116" y="260" width="332" height="14" rx="4"></rect>
            <rect class="line small" x="116" y="286" width="246" height="14" rx="4"></rect>
            <rect class="cta" x="116" y="332" width="190" height="50" rx="8"></rect>
            <rect class="phone" x="458" y="220" width="120" height="196" rx="22"></rect>
            <rect class="phone-screen" x="474" y="248" width="88" height="112" rx="8"></rect>
            <path class="mini-chart" d="M492 338h14v22h-14zM516 318h14v42h-14zM540 292h14v68h-14z"></path>
            <path class="base" d="M42 462h636l-38 72H80z"></path>
            <path class="trackpad" d="M300 482h120l-12 24h-96z"></path>
          </svg>
        </aside>
      </section>

      <section class="section problem" id="problema" aria-labelledby="problem-title">
        <div class="problem__copy">
          <p class="eyebrow">O problema</p>
          <h2 id="problem-title">Por que tantos sites nao geram resultado?</h2>
          <p>
            Normalmente o problema nao e o design. O visitante ate pode gostar da pagina, mas ele
            nao encontra resposta rapida, nao entende por que chamar sua empresa e nao tem um caminho
            simples para pedir orcamento.
          </p>
          <p>
            Quando busca, mensagem, velocidade e conversao nao trabalham juntas, o site vira custo.
            Ele recebe visitas soltas e devolve pouca conversa comercial.
          </p>
        </div>
        <aside class="problem-map" aria-label="Principais motivos de um site nao gerar contatos">
          {problemItems.map((item) => (
            <span>{item}</span>
          ))}
        </aside>
      </section>

      <section class="section strategy-shift" aria-labelledby="before-after-title">
        <div class="strategy-shift__header">
          <p class="eyebrow">Antes x Depois</p>
          <h2 id="before-after-title">O que muda quando o site tem funcao comercial.</h2>
        </div>
        <div class="comparison-board" aria-label="Comparativo antes e depois">
          <div class="comparison-board__head" aria-hidden="true">
            <span>Antes</span>
            <span>Depois</span>
          </div>
          <ul>
            {beforeItems.map((item, index) => (
              <li>
                <p class="comparison-item comparison-item--before">
                  <span aria-hidden="true">x</span>
                  {item}
                </p>
                <p class="comparison-item comparison-item--after">
                  <span aria-hidden="true">✓</span>
                  {afterItems[index]}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section method" id="metodo" aria-labelledby="method-title">
        <div class="section-header">
          <p class="eyebrow">Como construimos um site</p>
          <h2 id="method-title">Da busca no Google ao pedido de orcamento.</h2>
          <p>
            O processo foi montado para tirar decisoes do achismo. Primeiro entendemos o que precisa
            gerar receita; depois desenhamos a pagina para sustentar essa decisao.
          </p>
        </div>
        <ol class="timeline" aria-label="Etapas de criacao de site">
          {processSteps.map((item) => (
            <li>
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section deliverables" id="entregas" aria-labelledby="deliverables-title">
        <div class="deliverables__intro">
          <p class="eyebrow">O que todo site da ConverteUp entrega</p>
          <h2 id="deliverables-title">Uma base pronta para aquisicao, nao so publicacao.</h2>
          <p>
            Cada entrega existe para reduzir atrito: aparecer melhor, carregar rapido, explicar com
            clareza, medir comportamento e facilitar o contato.
          </p>
        </div>
        <div class="deliverables-map">
          <article class="deliverables-main">
            <span>Sistema de aquisicao</span>
            <h3>Busca, pagina, prova e contato trabalhando juntos.</h3>
            <p>
              Um bom site nao impressiona. Ele convence, explica e transforma visitantes em clientes.
            </p>
          </article>
          <ul>
            {deliverables.map(([title, text]) => (
              <li>
                <strong>{title}</strong>
                <p>{text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section case-study" id="case" aria-labelledby="case-title">
        <div class="case-study__intro">
          <p class="eyebrow">Case Reecell</p>
          <h2 id="case-title">O site deixou de ser vitrine e virou rota de aquisicao.</h2>
          <p>
            A Reecell ja tinha uma empresa real, demanda local e clientes satisfeitos. O gargalo era
            transformar essa forca em visibilidade e contatos mais previsiveis.
          </p>
        </div>
        <div class="case-story">
          <article>
            <span>Problema</span>
            <p>
              A presenca digital existia, mas a estrutura nao explicava bem os servicos, nao
              capturava todo o potencial de busca local e dependia demais de indicacao.
            </p>
          </article>
          <article>
            <span>O que fizemos</span>
            <p>
              Reorganizamos paginas por intencao, melhoramos a copy, conectamos SEO local, Google
              Business, blog e campanhas para levar o visitante ao contato certo.
            </p>
          </article>
          <article>
            <span>Resultado</span>
            <p>
              O projeto criou uma base mais rapida, mensuravel e preparada para crescer. Houve uma
              diferenca observada de aproximadamente R$ 40 mil em um mes, influenciada pelo conjunto
              da estrategia e por fatores externos do negocio.
            </p>
          </article>
        </div>
      </section>

      <section class="section trust" aria-labelledby="trust-title">
        <div class="trust__header">
          <p class="eyebrow">Depoimentos</p>
          <h2 id="trust-title">Quem trabalha com aquisicao percebe a diferenca.</h2>
        </div>
        <div class="testimonial-carousel" data-testimonial-carousel>
          <div class="testimonial-viewport">
            <ul class="testimonial-track">
              {testimonials.map((item) => (
                <li class="testimonial-slide">
                  <article class="testimonial-card">
                    <div class="testimonial-stars" aria-label="Avaliacao cinco estrelas">
                      <span aria-hidden="true">★★★★★</span>
                    </div>
                    <blockquote>{item.quote}</blockquote>
                    <footer>
                      <strong>{item.author}</strong>
                      <span>{item.role}</span>
                    </footer>
                  </article>
                </li>
              ))}
            </ul>
          </div>
          <div class="testimonial-controls" aria-label="Controles dos depoimentos">
            <div class="testimonial-dots" aria-hidden="true">
              {testimonials.map(() => <span></span>)}
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="faq" aria-labelledby="faq-title">
        <div class="section-header">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Duvidas antes de investir em um site comercial.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta" id="diagnostico" aria-labelledby="diagnostic-title">
        <div class="final-cta__copy">
          <p class="eyebrow">Diagnostico</p>
          <h2 id="diagnostic-title">Vamos transformar seu site em um canal de aquisicao de clientes?</h2>
          <p>
            Cada projeto comeca entendendo o negocio, a busca do cliente e o que precisa virar
            conversa comercial. O layout vem depois da estrategia.
          </p>
        </div>
        <form
          class="diagnostic-form"
          action="mailto:contato@converteup.com.br"
          method="post"
          enctype="text/plain"
        >
          <label>
            <span>Nome</span>
            <input name="nome" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Telefone</span>
            <input name="telefone" type="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>Assunto <small>(opcional)</small></span>
            <textarea name="assunto" rows="4"></textarea>
          </label>
          <button class="cta-button" type="submit">Solicitar diagnostico gratuito</button>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="/" aria-label="ConverteUp inicio">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <p>Sites, SEO e paginas de conversao para transformar procura em oportunidade comercial.</p>
      <a class="text-link" href="mailto:contato@converteup.com.br">contato@converteup.com.br</a>
    </footer>

    <script is:inline>
      (() => {
        const carousel = document.querySelector("[data-testimonial-carousel]");
        if (!carousel) return;

        const track = carousel.querySelector(".testimonial-track");
        const slides = Array.from(carousel.querySelectorAll(".testimonial-slide"));
        const dots = Array.from(carousel.querySelectorAll(".testimonial-dots span"));
        let index = 0;
        let timer;

        const visibleCount = () => (window.matchMedia("(min-width: 640px)").matches ? 2 : 1);
        const maxIndex = () => Math.max(0, slides.length - visibleCount());

        const update = (nextIndex = index) => {
          index = Math.max(0, Math.min(nextIndex, maxIndex()));
          track.style.transform = `translateX(-${slides[index].offsetLeft}px)`;
          dots.forEach((dot, dotIndex) => {
            dot.classList.toggle("is-active", dotIndex === index);
            dot.hidden = dotIndex > maxIndex();
          });
        };

        const start = () => {
          stop();
          timer = window.setInterval(() => update(index >= maxIndex() ? 0 : index + 1), 5200);
        };

        const stop = () => {
          if (timer) window.clearInterval(timer);
        };

        dots.forEach((dot, dotIndex) => {
          dot.addEventListener("click", () => {
            update(dotIndex);
            start();
          });
        });
        carousel.addEventListener("mouseenter", stop);
        carousel.addEventListener("mouseleave", start);
        carousel.addEventListener("focusin", stop);
        carousel.addEventListener("focusout", start);
        window.addEventListener("resize", () => update());

        update(0);
        start();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1f365c;
    --ink-soft: rgba(31, 54, 92, 0.76);
    --ink-muted: rgba(31, 54, 92, 0.56);
    --paper: #f7f3ea;
    --paper-strong: #fffaf0;
    --panel: rgba(255, 250, 240, 0.9);
    --olive: #6f9934;
    --moss: #6f9934;
    --line: rgba(31, 54, 92, 0.15);
    --shadow: 0 16px 42px rgba(31, 54, 92, 0.08);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    color: var(--ink);
    background: var(--paper);
    font-size: 1rem;
    line-height: 1.62;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3 {
    font-family: "Manrope", "Segoe UI", sans-serif;
    line-height: 1;
    letter-spacing: 0;
  }

  h1 {
    max-width: 14ch;
    font-size: 2.44rem;
    font-weight: 800;
  }

  h2 {
    max-width: 13ch;
    font-size: 2.18rem;
    font-weight: 800;
  }

  h3 {
    font-size: 1.35rem;
    font-weight: 800;
  }

  a {
    color: inherit;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 20;
