---
import SiteNavigation from "../components/SiteNavigation.astro";
import CtaButton from "../components/CtaButton.astro";
import SeoHead from "../components/SeoHead.astro";
import { CONTACT_EMAIL, WHATSAPP_HREF, absoluteUrl } from "../config/site.js";

const processSteps = [
  {
    step: "01",
    title: "Diagnóstico",
    text: "Entendemos mercado, oferta, concorrentes, buscas e o tipo de contato que realmente vale para o negócio.",
  },
  {
    step: "02",
    title: "Arquitetura",
    text: "Organizamos páginas, seções e caminhos para o visitante encontrar resposta sem esforço.",
  },
  {
    step: "03",
    title: "Copy",
    text: "Escrevemos a mensagem comercial para explicar valor, reduzir dúvida e levar ao próximo passo.",
  },
  {
    step: "04",
    title: "Design",
    text: "Criamos uma interface clara, rápida e coerente com a decisão que o visitante precisa tomar.",
  },
  {
    step: "05",
    title: "SEO Técnico",
    text: "Preparamos estrutura, metadados, headings, links internos, performance e leitura pelos buscadores.",
  },
  {
    step: "06",
    title: "Publicação",
    text: "Publicamos com rastreamento, formulário, WhatsApp, analytics e pontos básicos de segurança.",
  },
  {
    step: "07",
    title: "Evolução",
    text: "Medimos comportamento, buscas, contatos e gargalos para melhorar o canal depois do lançamento.",
  },
];

const beforeItems = [
  "Site bonito",
  "Sem visitantes",
  "Sem SEO",
  "Cliente entra e sai",
  "Sem estratégia",
];

const afterItems = [
  "Preparado para o Google",
  "Copy orientada para conversão",
  "Mobile First",
  "Performance alta",
  "Contato simples",
];

const problemItems = [
  "O visitante entra e não entende o que você faz.",
  "Seu site demora para carregar.",
  "O Google não encontra suas páginas.",
  "Não existe um caminho claro para contato.",
  "O visitante entra... e simplesmente vai embora.",
];

const deliverables = [
  ["SEO Técnico", "Base para o Google entender páginas, serviços e localização."],
  ["Mobile First", "Layout pensado primeiro para quem decide pelo celular."],
  ["Core Web Vitals", "Estrutura estável, rápida e confortável para leitura."],
  ["Copy Comercial", "Texto escrito para vender o próximo passo, não apenas preencher seção."],
  ["Google Business", "Conexao entre site, busca local e perfil da empresa."],
  ["Integração com WhatsApp", "Contato visível nos pontos em que a decisão costuma acontecer."],
  ["Landing Pages", "Páginas específicas para campanhas, serviços ou cidades estratégicas."],
  ["Blog otimizado", "Conteúdo planejado para responder buscas e aumentar superfície orgânica."],
  ["Google Analytics", "Medição de acesso, origem e comportamento dentro do site."],
  ["Microsoft Clarity", "Mapas de calor e gravações para encontrar atritos reais."],
  ["Estrutura escalável", "Base preparada para novas páginas, conteúdos e campanhas."],
  ["Performance elevada", "Codigo limpo, imagens leves e carregamento sem excesso de scripts."],
];

const faqs = [
  {
    question: "Quanto custa criar um site profissional?",
    answer:
      "Depende da quantidade de páginas, nível de copy, integrações e estratégia de SEO. Antes de passar valor, avaliamos objetivo comercial, concorrência e o que o site precisa entregar para gerar contatos qualificados.",
  },
  {
    question: "Quanto tempo demora?",
    answer:
      "O prazo depende do escopo e da velocidade de aprovação. Uma página mais direta pode ser publicada rapidamente; sites com várias páginas, SEO e conteúdo exigem mais planejamento.",
  },
  {
    question: "Meu site aparece no Google?",
    answer:
      "Ele já nasce com base técnica para indexação: estrutura semântica, headings, metadados, links internos e performance. Posição no Google depende de concorrência, autoridade, conteúdo e evolução contínua.",
  },
  {
    question: "Vale a pena reformular um site antigo?",
    answer:
      "Vale quando o site atual limita velocidade, clareza, SEO ou conversão. Em alguns casos, aproveitar a base e reorganizar mensagem, páginas e CTAs é suficiente.",
  },
  {
    question: "Posso contratar apenas o site?",
    answer:
      "Sim. O site pode ser contratado como projeto único. Mesmo assim, ele será pensado como parte de um sistema de aquisição, preparado para receber SEO, anúncios e mensuração depois.",
  },
  {
    question: "O site ja fica preparado para Google Ads?",
    answer:
      "Sim. A página pode sair com mensagem, velocidade, rastreamento e caminho de contato adequados para campanhas. Isso evita mandar tráfego pago para uma página que não explica nem converte.",
  },
  {
    question: "Vocês fazem manutenção?",
    answer:
      "Sim. Podemos acompanhar melhorias, conteúdo, ajustes técnicos, novas páginas e leitura dos dados depois da publicação.",
  },
  {
    question: "O site será rápido?",
    answer:
      "A construção prioriza performance, HTML semântico, CSS organizado, imagens leves e pouco JavaScript. A meta é entregar uma página rápida e confortável no celular.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Criação de Sites com foco em aquisição de clientes",
  provider: {
    "@type": "Organization",
    name: "ConverteUp",
    url: absoluteUrl("/"),
  },
  areaServed: "BR",
  serviceType: "Criação de sites, SEO técnico, copy comercial e landing pages",
  description:
    "Criação de sites rápidos, mobile first e preparados para gerar contatos, orçamentos e vendas.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: absoluteUrl("/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Criação de Sites",
      item: absoluteUrl("/criacao-de-sites"),
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const pageTitle = "Criação de Sites | ConverteUp";
const pageDescription =
  "Criação de sites para empresas que precisam gerar contatos, orçamentos e vendas com SEO técnico, copy comercial, performance e WhatsApp integrado.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      ogDescription="Sites rápidos, claros e preparados para transformar visitantes em oportunidades de negócio."
      schema={[serviceSchema, breadcrumbSchema, faqSchema]}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <SiteNavigation />
      <CtaButton href={WHATSAPP_HREF} label="Solicitar diagnóstico" variant="secondary" />
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">Criação de Sites</p>
          <h1 id="hero-title">Seu site deve trabalhar para conquistar clientes.</h1>
          <p class="hero__lead">
            Hoje, muitos sites funcionam apenas como um cartão de visitas digital. Nós criamos
            páginas pensadas para aparecer nas buscas, explicar seu diferencial e transformar
            visitas em contatos reais.
          </p>
          <div class="hero__actions">
            <CtaButton href={WHATSAPP_HREF} label="Solicitar diagnóstico" />
          </div>
          <ul class="hero__signals" aria-label="Prioridades do projeto">
            <li>SEO</li>
            <li>Copy</li>
            <li>Performance</li>
            <li>Conversão</li>
          </ul>
        </div>

        <aside class="site-preview" aria-label="Imagem principal da criação de sites da ConverteUp">
          <img
            src="/Image/Hero/Criacao-hero.webp"
            alt="Imagem visual gerada para representar criação de sites da ConverteUp"
            width="1448"
            height="1086"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </aside>
      </section>

      <section class="section problem" id="problema" aria-labelledby="problem-title">
        <div class="problem__copy">
          <p class="eyebrow">O problema</p>
          <h2 id="problem-title">Por que tantos sites não geram resultado?</h2>
          <p>
            Normalmente o problema não é o design. O visitante até pode gostar da página, mas ele
            não encontra resposta rápida, não entende por que chamar sua empresa e não tem um caminho
            simples para pedir orçamento.
          </p>
          <p>
            Quando busca, mensagem, velocidade e conversão não trabalham juntas, o site vira custo.
            Ele recebe visitas soltas e devolve pouca conversa comercial.
          </p>
        </div>
        <aside class="problem-map" aria-label="Principais motivos de um site não gerar contatos">
          {problemItems.map((item) => (
            <span>{item}</span>
          ))}
        </aside>
      </section>

      <section class="section strategy-shift" aria-labelledby="before-after-title">
        <div class="strategy-shift__header">
          <p class="eyebrow">Antes x Depois</p>
          <h2 id="before-after-title">O que muda quando o site tem função comercial.</h2>
        </div>
        <div class="comparison-board" aria-label="Comparativo antes e depois">
          <div class="comparison-board__head" aria-hidden="true">
            <span>Antes</span>
            <span>Depois</span>
          </div>
          <ul>
            {beforeItems.map((item, index) => (
              <li>
                <p class="comparison-item comparison-item--before">
                  <span aria-hidden="true">x</span>
                  {item}
                </p>
                <p class="comparison-item comparison-item--after">
                  <span aria-hidden="true">✓</span>
                  {afterItems[index]}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section method" id="metodo" aria-labelledby="method-title">
        <div class="section-header">
          <p class="eyebrow">Como construímos um site</p>
          <h2 id="method-title">Da busca no Google ao pedido de orçamento.</h2>
          <p>
            O processo foi montado para tirar decisões do achismo. Primeiro entendemos o que precisa
            gerar receita; depois desenhamos a página para sustentar essa decisão.
          </p>
        </div>
        <ol class="timeline" aria-label="Etapas de criação de site">
          {processSteps.map((item) => (
            <li>
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section deliverables" id="entregas" aria-labelledby="deliverables-title">
        <div class="deliverables__intro">
          <p class="eyebrow">ENTREGAS</p>
          <h2 id="deliverables-title">Tudo que seu site precisa para atrair, convencer e converter.</h2>
          <p>
            Cada entrega existe para reduzir o atrito entre a busca do cliente e o primeiro contato
            com sua empresa. A tecnologia fica nos bastidores; o resultado aparece na experiência,
            na velocidade e nas oportunidades geradas.
          </p>
        </div>
        <ol class="deliverables-strip" aria-label="Principais entregas do site">
          <li>
            <strong>Aparecer</strong>
            <p>SEO técnico, páginas por serviço e estrutura para buscas locais.</p>
          </li>
          <li>
            <strong>Carregar</strong>
            <p>Core Web Vitals, imagens leves e código organizado.</p>
          </li>
          <li>
            <strong>Converter</strong>
            <p>Copy comercial, WhatsApp visível e páginas orientadas a contato.</p>
          </li>
          <li>
            <strong>Medir</strong>
            <p>Analytics, Clarity e melhoria contínua baseada em comportamento.</p>
          </li>
        </ol>
        <p class="deliverables-footnote">
          Google Business, blog otimizado e estrutura escalável completam a base.
        </p>
      </section>

      <section class="section case-study" id="case" aria-labelledby="case-title">
        <div class="case-study__intro">
          <p class="eyebrow">Case Reecell</p>
          <h2 id="case-title">O site deixou de ser vitrine e virou rota de aquisição.</h2>
          <p>
            A Reecell ja tinha uma empresa real, demanda local e clientes satisfeitos. O gargalo era
            transformar essa forca em visibilidade e contatos mais previsiveis.
          </p>
        </div>
        <div class="case-story">
          <article>
            <span>Problema</span>
            <p>
              A presença digital existia, mas a estrutura não explicava bem os serviços, não
              capturava todo o potencial de busca local e dependia demais de indicacao.
            </p>
          </article>
          <article>
            <span>O que fizemos</span>
            <p>
              Reorganizamos páginas por intenção, melhoramos a copy, conectamos SEO local, Google
              Business, blog e campanhas para levar o visitante ao contato certo.
            </p>
          </article>
          <article>
            <span>Resultado</span>
            <p>
              O projeto criou uma base mais rápida, mensurável e preparada para crescer. Houve uma
              diferenca observada de aproximadamente R$ 40 mil em um mes, influenciada pelo conjunto
              da estratégia e por fatores externos do negócio.
            </p>
          </article>
        </div>
      </section>
      <section class="section faq" id="faq" aria-labelledby="faq-title">
        <div class="section-header">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Dúvidas antes de investir em um site comercial.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta" id="diagnostico" aria-labelledby="diagnostic-title">
        <div class="final-cta__copy">
          <p class="eyebrow">Diagnóstico</p>
          <h2 id="diagnostic-title">Vamos transformar seu site em um canal de aquisição de clientes?</h2>
          <p>
            Cada projeto começa entendendo o negócio, a busca do cliente e o que precisa virar
            conversa comercial. O layout vem depois da estratégia.
          </p>
        </div>
        <form
          class="diagnostic-form"
          action={`mailto:${CONTACT_EMAIL}`}
          method="post"
          enctype="text/plain"
          data-conversion="contact-form"
        >
          <label>
            <span>Nome</span>
            <input name="nome" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>Telefone</span>
            <input name="telefone" type="tel" autocomplete="tel" required />
          </label>
          <label>
            <span>Assunto <small>(opcional)</small></span>
            <textarea name="assunto" rows="4"></textarea>
          </label>
          <button class="cta-button" type="submit" data-cta="form-submit" data-conversion="contact-form">
            Solicitar diagnóstico gratuito
          </button>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="/" aria-label="ConverteUp início">
        <span class="brand-mark">C</span>
        <span>ConverteUp</span>
      </a>
      <p>Sites, SEO e páginas de conversão para transformar procura em oportunidade comercial.</p>
      <a class="text-link" href={`mailto:${CONTACT_EMAIL}`} data-cta="email">{CONTACT_EMAIL}</a>
    </footer>

  </body>
</html>

<style is:global>
  :root {
    --ink: #183153;
    --ink-soft: rgba(31, 54, 92, 0.76);
    --ink-muted: rgba(31, 54, 92, 0.56);
    --paper: #eeebd3;
    --paper-strong: #faf8ea;
    --panel: rgba(255, 250, 240, 0.9);
    --olive: #679436;
    --moss: #5c946e;
    --line: rgba(31, 54, 92, 0.15);
    --shadow: 0 16px 42px rgba(31, 54, 92, 0.08);
    --radius-button: 8px;
    --radius-card: 8px;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 72px;
    --space-9: 96px;
    --space-10: 128px;
    color: var(--ink);
    background: var(--paper);
    font-family: "Inter", "Segoe UI", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html,
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
  }

  body {
    color: var(--ink);
    background: var(--paper);
    font-size: 1rem;
    line-height: 1.62;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3 {
    font-family: "Manrope", "Segoe UI", sans-serif;
    line-height: 1;
    letter-spacing: 0;
  }

  h1 {
    max-width: 14ch;
    font-size: 2.44rem;
    font-weight: 800;
  }

  h2 {
    max-width: 13ch;
    font-size: 2.18rem;
    font-weight: 800;
  }

  h3 {
    font-size: 1.35rem;
    font-weight: 800;
  }

  a {
    color: inherit;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 20;
    transform: translateY(-160%);
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: var(--olive);
    color: #ffffff;
    padding: var(--space-3) var(--space-4);
    font-weight: 800;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  .hero,
  .section,
  .final-cta,
  .site-footer {
    width: calc(100% - 40px);
    max-width: 1180px;
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--olive);
    color: #ffffff;
    font-size: 0.95rem;
  }

  nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  nav a,
  .text-link,
  .site-footer a:not(.brand) {
    color: var(--ink-soft);
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  .text-link:hover,
  .site-footer a:not(.brand):hover {
    color: var(--ink);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--olive);
    box-shadow: 6px 6px 0 var(--ink);
    color: #ffffff;
    font-weight: 800;
    line-height: 1.15;
    padding: var(--space-3) var(--space-5);
    text-align: center;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .cta-button:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .cta-button--secondary {
    background: var(--paper-strong);
    box-shadow: none;
    color: var(--ink);
  }

  .site-header .cta-button {
    display: none;
  }

  .cta-button:focus-visible,
  a:focus-visible,
  summary:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid rgba(111, 153, 52, 0.42);
    outline-offset: 4px;
  }

  .eyebrow {
    color: var(--moss);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-7) var(--space-9);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__lead {
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.58;
  }

  .hero__actions {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    align-items: center;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__signals li {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__signals li + li::before {
    content: "/";
    margin-inline: var(--space-3);
    color: var(--olive);
  }

  .site-preview {
    min-width: 0;
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .site-preview img {
    display: block;
    width: min(100%, 1540px);
    height: auto;
    margin-inline: auto;
    border-radius: var(--radius-card);
    object-fit: contain;
    box-shadow: none;
  }

  .section {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .section-header,
  .problem__copy,
  .deliverables__intro,
  .trust__header,
  .case-study__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 820px;
  }

  .section-header p:not(.eyebrow),
  .problem__copy p:not(.eyebrow),
  .deliverables__intro p:not(.eyebrow),
  .trust__header p:not(.eyebrow),
  .case-study__intro p:not(.eyebrow) {
    max-width: 690px;
    color: var(--ink-soft);
    font-size: 1.06rem;
    line-height: 1.68;
  }

  .problem {
